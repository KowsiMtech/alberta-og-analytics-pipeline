{
	"name": "PL_MD_Reconciliation",
	"properties": {
		"description": "Reconciliation understands quarantine and dedup: Source = Silver + Quarantine; RawStaging = Staging + Duplicates.",
		"activities": [
			{
				"name": "Reconcile_Counts",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_ReconcileCountsV2 @EntityName=''',pipeline().parameters.EntityName,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,''', @SourceCount=',string(pipeline().parameters.SourceCount),', @SilverCount=',string(pipeline().parameters.SilverCount),', @QuarantineCount=',string(pipeline().parameters.QuarantineCount),', @RawStagingCount=',string(pipeline().parameters.RawStagingCount),', @DuplicateCount=',string(pipeline().parameters.DuplicateCount),', @StagingCount=',string(pipeline().parameters.StagingCount))",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set_Reconciliation_Status",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Reconcile_Counts",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_Status",
					"value": {
						"value": "@activity('Reconcile_Counts').output.firstRow.ReconciliationStatus",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If_Reconciliation_Failed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set_Reconciliation_Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_Status'),'FAIL')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Reconciliation_Pass",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "RECONCILIATION",
										"type": "String"
									},
									"Status": {
										"value": "SUCCESS",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Alert_Reconciliation_Failure",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Common_Alert_Handler",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"AlertType": "RECONCILIATION_FAILURE",
									"Severity": "CRITICAL",
									"ActivityName": "RECONCILIATION",
									"Message": "Count reconciliation failed. Watermark must not advance."
								}
							}
						},
						{
							"name": "Fail_Reconciliation",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Alert_Reconciliation_Failure",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Count reconciliation failed",
								"errorCode": "RECONCILIATION_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"SourceCount": {
				"type": "Int64"
			},
			"SilverCount": {
				"type": "Int64"
			},
			"QuarantineCount": {
				"type": "Int64"
			},
			"RawStagingCount": {
				"type": "Int64"
			},
			"DuplicateCount": {
				"type": "Int64"
			},
			"StagingCount": {
				"type": "Int64"
			}
		},
		"variables": {
			"v_Status": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}