{
	"name": "PL_MD_Reconciliation",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Run_Counts",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT TOP 1 COALESCE(SourceRowCount,0) SourceCount,COALESCE(SilverRowCount,0) SilverCount,COALESCE(QuarantineRowCount,0) QuarantineCount,COALESCE(StagingRowCount,0) StagingCount FROM control.PipelineControl WHERE EntityName=''',pipeline().parameters.EntityName,''' AND PipelineRunId=''',pipeline().parameters.ParentRunId,''' AND BatchId=''',pipeline().parameters.BatchId,''' ORDER BY PipelineControlId DESC')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Reconcile",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup_Run_Counts",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_ReconcileCounts @EntityName=''',pipeline().parameters.EntityName,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,''', @SourceCount=',string(activity('Lookup_Run_Counts').output.firstRow.SourceCount),', @SilverCount=',string(activity('Lookup_Run_Counts').output.firstRow.SilverCount),', @QuarantineCount=',string(activity('Lookup_Run_Counts').output.firstRow.QuarantineCount),', @StagingCount=',string(activity('Lookup_Run_Counts').output.firstRow.StagingCount))",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Reconciliation_Failed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Reconcile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Reconcile').output.firstRow.ReconciliationStatus,'FAIL')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Alert_Reconciliation",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Common_Alert_Handler",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"AlertType": "RECONCILIATION_FAILURE",
									"Severity": "CRITICAL",
									"ActivityName": "Reconciliation",
									"Message": "Source/Silver/Quarantine/Staging count mismatch"
								}
							}
						},
						{
							"name": "Fail_Reconciliation",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Alert_Reconciliation",
									"dependencyConditions": [
										"Succeeded",
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Reconciliation failed",
								"errorCode": "RECONCILIATION_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven_Pipeline"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ST37_SEEDED"
		]
	}
}