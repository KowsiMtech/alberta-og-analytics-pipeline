{
	"name": "PL_MD_Gold_Load",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Gold_Script",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT ScriptTemplate FROM control.EntityTransformScript WHERE EntityName=''',pipeline().parameters.EntityName,''' AND StageName=''GOLD_LOAD'' AND IsActive=1')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Run_Gold_Load",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Lookup_Gold_Script",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "@activity('Lookup_Gold_Script').output.firstRow.ScriptTemplate",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ST37_SEEDED"
		]
	}
}