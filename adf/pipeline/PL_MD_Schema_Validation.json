{
	"name": "PL_MD_Schema_Validation",
	"properties": {
		"description": "Versioned runtime schema validation with explicit entity data-contract requiredness. ADF visibly routes NO_CHANGE/COMPATIBLE/BREAKING; SQL only compares and persists evidence.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Schema_Check_Enabled",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Lookup_Config').output.firstRow.SchemaCheckEnabled,true)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Schema_Disabled",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "SCHEMA_VALIDATION",
										"type": "String"
									},
									"Status": {
										"value": "SKIPPED",
										"type": "String"
									},
									"Detail": {
										"value": "Schema check disabled in EntityConfig",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Switch_Source_For_Schema",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "If_Schema_Check_Enabled",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@if(equals(activity('Lookup_Config').output.firstRow.SchemaCheckEnabled,true),activity('Lookup_Config').output.firstRow.SourceType,'__SKIP__')",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "SQL",
							"activities": [
								{
									"name": "Lookup_Actual_SQL_Schema",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlSource",
											"sqlReaderQuery": {
												"value": "@concat('SELECT COLUMN_NAME AS ColumnName, DATA_TYPE AS DataType, CASE WHEN IS_NULLABLE = ''YES'' THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END AS IsNullable, ORDINAL_POSITION AS OrdinalPosition FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = ''', activity('Lookup_Config').output.firstRow.SourceSchema, ''' AND TABLE_NAME = ''', activity('Lookup_Config').output.firstRow.SourceObject, ''' ORDER BY ORDINAL_POSITION')",
												"type": "Expression"
											},
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_MD_SourceSql",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@activity('Lookup_Config').output.firstRow.SourceSchema",
													"type": "Expression"
												},
												"TableName": {
													"value": "@activity('Lookup_Config').output.firstRow.SourceObject",
													"type": "Expression"
												}
											}
										},
										"firstRowOnly": false
									}
								},
								{
									"name": "Compare_Schema",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "Lookup_Actual_SQL_Schema",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat('EXEC control.usp_CompareSchema @EntityName=''',pipeline().parameters.EntityName,''', @ActualSchemaJson=N''',replace(string(activity('Lookup_Actual_SQL_Schema').output.value),'''',''''''),''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,'''')",
												"type": "Expression"
											},
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_MD_Control",
											"type": "DatasetReference"
										},
										"firstRowOnly": true
									}
								},
								{
									"name": "Set_SchemaStatus",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Compare_Schema",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_SchemaStatus",
										"value": {
											"value": "@activity('Compare_Schema').output.firstRow.SchemaStatus",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "REST_API",
							"activities": [
								{
									"name": "Log_REST_Schema_Hook",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "control.usp_RecordStage",
										"storedProcedureParameters": {
											"EntityName": {
												"value": {
													"value": "@pipeline().parameters.EntityName",
													"type": "Expression"
												},
												"type": "String"
											},
											"PipelineRunId": {
												"value": {
													"value": "@pipeline().parameters.ParentRunId",
													"type": "Expression"
												},
												"type": "String"
											},
											"BatchId": {
												"value": {
													"value": "@pipeline().parameters.BatchId",
													"type": "Expression"
												},
												"type": "String"
											},
											"WindowKey": {
												"value": {
													"value": "@pipeline().parameters.WindowKey",
													"type": "Expression"
												},
												"type": "String"
											},
											"StageName": {
												"value": "SCHEMA_VALIDATION",
												"type": "String"
											},
											"Status": {
												"value": "WARNING",
												"type": "String"
											},
											"Detail": {
												"value": "REST schema profile requires endpoint response normalization; SQL entity path fully enforced.",
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						},
						{
							"value": "__SKIP__",
							"activities": [
								{
									"name": "Skip_Schema_Source_Check",
									"type": "Wait",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": 1
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Fail_Unsupported_Schema_Source",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Unsupported source type",
								"errorCode": "SCHEMA_UNSUPPORTED_SOURCE"
							}
						}
					]
				}
			},
			{
				"name": "Handle_Schema_Status",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Switch_Source_For_Schema",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_MD_Schema_Status_Handler",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"EntityName": {
							"value": "@pipeline().parameters.EntityName",
							"type": "Expression"
						},
						"BatchId": {
							"value": "@pipeline().parameters.BatchId",
							"type": "Expression"
						},
						"ParentRunId": {
							"value": "@pipeline().parameters.ParentRunId",
							"type": "Expression"
						},
						"WindowKey": {
							"value": "@pipeline().parameters.WindowKey",
							"type": "Expression"
						},
						"SchemaStatus": {
							"value": "@if(equals(activity('Lookup_Config').output.firstRow.SchemaCheckEnabled,true),if(equals(activity('Lookup_Config').output.firstRow.SourceType,'SQL'),variables('v_SchemaStatus'),'NO_CHANGE'),'__SKIP__')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"variables": {
			"v_SchemaStatus": {
				"type": "String"
			}
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED",
			"DATA_CONTRACT"
		]
	}
}