{
	"name": "PL_MD_Schema_Validation",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_SQL",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Lookup_Config').output.firstRow.SourceType,'SQL')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "REST_Schema_Profile_Hook",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Lookup_Actual_Schema",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT COLUMN_NAME ColumnName,DATA_TYPE DataType,CASE WHEN IS_NULLABLE=''''YES'''' THEN CAST(1 AS bit) ELSE CAST(0 AS bit) END IsNullable,ORDINAL_POSITION OrdinalPosition FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=''''',activity('Lookup_Config').output.firstRow.SourceSchema,'''' AND TABLE_NAME=''''',activity('Lookup_Config').output.firstRow.SourceObject,'''' ORDER BY ORDINAL_POSITION')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_SourceSql",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": {
											"value": "@activity('Lookup_Config').output.firstRow.SourceSchema",
											"type": "Expression"
										},
										"TableName": {
											"value": "@activity('Lookup_Config').output.firstRow.SourceObject",
											"type": "Expression"
										}
									}
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "Compare_Schema",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Lookup_Actual_Schema",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_CompareOrInitializeSchema @EntityName=''',pipeline().parameters.EntityName,''', @ActualSchemaJson=N''',replace(string(activity('Lookup_Actual_Schema').output.value),'''',''''''),''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,'''')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Switch_Schema_Status",
							"type": "Switch",
							"dependsOn": [
								{
									"activity": "Compare_Schema",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@activity('Compare_Schema').output.firstRow.SchemaStatus",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "BREAKING_CHANGE",
										"activities": [
											{
												"name": "Alert_Breaking",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_MD_Common_Alert_Handler",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"EntityName": {
															"value": "@pipeline().parameters.EntityName",
															"type": "Expression"
														},
														"BatchId": {
															"value": "@pipeline().parameters.BatchId",
															"type": "Expression"
														},
														"ParentRunId": {
															"value": "@pipeline().parameters.ParentRunId",
															"type": "Expression"
														},
														"WindowKey": {
															"value": "@pipeline().parameters.WindowKey",
															"type": "Expression"
														},
														"AlertType": "SCHEMA_BREAKING_CHANGE",
														"Severity": "CRITICAL",
														"ActivityName": "SchemaValidation",
														"Message": "Breaking schema drift detected"
													}
												}
											},
											{
												"name": "Fail_Breaking",
												"type": "Fail",
												"dependsOn": [
													{
														"activity": "Alert_Breaking",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"userProperties": [],
												"typeProperties": {
													"message": "Breaking schema drift detected",
													"errorCode": "SCHEMA_BREAKING_CHANGE"
												}
											}
										]
									},
									{
										"value": "COMPATIBLE_CHANGE",
										"activities": [
											{
												"name": "Alert_Compatible",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_MD_Common_Alert_Handler",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"EntityName": {
															"value": "@pipeline().parameters.EntityName",
															"type": "Expression"
														},
														"BatchId": {
															"value": "@pipeline().parameters.BatchId",
															"type": "Expression"
														},
														"ParentRunId": {
															"value": "@pipeline().parameters.ParentRunId",
															"type": "Expression"
														},
														"WindowKey": {
															"value": "@pipeline().parameters.WindowKey",
															"type": "Expression"
														},
														"AlertType": "SCHEMA_COMPATIBLE_CHANGE",
														"Severity": "WARNING",
														"ActivityName": "SchemaValidation",
														"Message": "Compatible schema drift detected"
													}
												}
											}
										]
									},
									{
										"value": "BASELINE_CREATED",
										"activities": [
											{
												"name": "Baseline_Created",
												"type": "Wait",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"waitTimeInSeconds": 1
												}
											}
										]
									},
									{
										"value": "NO_CHANGE",
										"activities": [
											{
												"name": "No_Schema_Change",
												"type": "Wait",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"waitTimeInSeconds": 1
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven_Pipeline"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ST37_SEEDED"
		]
	}
}