						"ActivityName": "{\"value\":\"Get_Staging_RowCount\",\"type\":\"String\"}",
						"ErrorMessage": "{\"value\":{\"value\":\"@activity('Get_Staging_RowCount').error.message\",\"type\":\"Expression\"},\"type\":\"String\"}",
						"ErrorCode": "{\"value\":\"STAGING_ROWCOUNT_FAILED\",\"type\":\"String\"}",
						"BatchId": "{\"value\":{\"value\":\"@pipeline().parameters.BatchId\",\"type\":\"Expression\"},\"type\":\"String\"}",
						"WindowKey": "{\"value\":{\"value\":\"@pipeline().parameters.WindowKey\",\"type\":\"Expression\"},\"type\":\"String\"}"
					}
				}
			},
