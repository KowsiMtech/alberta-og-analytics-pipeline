											"source": {
												"name": "LicenceIssueDate",
												"type": "DateTime",
												"physicalType": "DATE"
											},
											"sink": {
												"name": "LicenceIssueDate",
												"type": "Date",
												"physicalType": "date"
											}
										},
										{
											"source": {
												"name": "LicenseeCode",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "LicenseeCode",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "OperatorCode",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "OperatorCode",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "FinDrlDate",
												"type": "DateTime",
												"physicalType": "DATE"
											},
											"sink": {
												"name": "FinDrlDate",
												"type": "Date",
												"physicalType": "date"
											}
										},
										{
											"source": {
												"name": "WellTotalDepth",
												"type": "Decimal",
												"physicalType": "DECIMAL",
												"scale": 2,
												"precision": 10
											},
											"sink": {
												"name": "WellTotalDepth",
												"type": "Decimal",
												"physicalType": "decimal",
												"scale": 2,
												"precision": 10
											}
										},
										{
											"source": {
												"name": "WellStatCode",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "WellStatCode",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "WellStatDate",
												"type": "DateTime",
												"physicalType": "DATE"
											},
											"sink": {
												"name": "WellStatDate",
												"type": "Date",
												"physicalType": "date"
											}
										},
										{
											"source": {
												"name": "FluidDesc",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "FluidDesc",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "ModeDesc",
