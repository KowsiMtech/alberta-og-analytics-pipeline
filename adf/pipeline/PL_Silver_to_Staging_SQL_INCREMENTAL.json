												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "WellName",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "WellName",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "FieldCode",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "FieldCode",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "PoolCode",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "PoolCode",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "LicenceNumber",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "LicenceNumber",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "LicenceStatus",
