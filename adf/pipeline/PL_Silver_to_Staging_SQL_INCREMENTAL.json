											},
											"sink": {
												"name": "ModeDesc",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "TypeDesc",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "TypeDesc",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
										{
											"source": {
												"name": "StructureDesc",
												"type": "String",
												"physicalType": "UTF8"
											},
											"sink": {
												"name": "StructureDesc",
												"type": "String",
												"physicalType": "nvarchar"
											}
										},
