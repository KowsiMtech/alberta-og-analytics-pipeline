{
	"name": "PL_MD_Master",
	"properties": {
		"description": "Master processes active entities by execution wave and bounded parallelism; EntityName is the runtime contract.",
		"activities": [
			{
				"name": "Set_BatchId",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_BatchId",
					"value": {
						"value": "@concat(formatDateTime(utcnow(),'yyyyMMddHHmmss'),'_',substring(guid(),0,8))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Reconcile_Stale_Runs",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set_BatchId",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_CloseStalePipelineRuns"
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Lookup_Waves",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Reconcile_Stale_Runs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT DISTINCT ExecutionWave FROM control.EntityConfig WHERE IsActive=1 ORDER BY ExecutionWave')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Wave",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Waves",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Waves').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Lookup_Entities_For_Wave",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM control.EntityConfig WHERE IsActive=1 AND ExecutionWave=',string(item().ExecutionWave),' ORDER BY Priority,EntityName')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "ForEach_Entity",
							"type": "ForEach",
							"dependsOn": [
								{
									"activity": "Lookup_Entities_For_Wave",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('Lookup_Entities_For_Wave').output.value",
									"type": "Expression"
								},
								"isSequential": false,
								"batchCount": 4,
								"activities": [
									{
										"name": "Check_Dependency",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat('EXEC control.usp_GetDependencyStatus @EntityName=''',item().EntityName,''', @BatchId=''',variables('v_BatchId'),'''')",
													"type": "Expression"
												},
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "DS_MD_Control",
												"type": "DatasetReference"
											},
											"firstRowOnly": true
										}
									},
									{
										"name": "If_Dependency_Ready",
										"type": "IfCondition",
										"dependsOn": [
											{
												"activity": "Check_Dependency",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"expression": {
												"value": "@equals(activity('Check_Dependency').output.firstRow.DependencyStatus,'READY')",
												"type": "Expression"
											},
											"ifFalseActivities": [
												{
													"name": "Alert_Dependency_Blocked",
													"type": "ExecutePipeline",
													"dependsOn": [],
													"policy": {
														"secureInput": false
													},
													"userProperties": [],
													"typeProperties": {
														"pipeline": {
															"referenceName": "PL_MD_Common_Alert_Handler",
															"type": "PipelineReference"
														},
														"waitOnCompletion": true,
														"parameters": {
															"EntityName": {
																"value": "@item().EntityName",
																"type": "Expression"
															},
															"BatchId": {
																"value": "@variables('v_BatchId')",
																"type": "Expression"
															},
															"ParentRunId": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"WindowKey": "",
															"AlertType": "DEPENDENCY_BLOCKED",
															"Severity": "WARNING",
															"ActivityName": "MASTER_DEPENDENCY",
															"Message": "Entity dependency was not successful in the current batch."
														}
													}
												}
											],
											"ifTrueActivities": [
												{
													"name": "Run_Entity",
													"type": "ExecutePipeline",
													"dependsOn": [],
													"policy": {
														"secureInput": false
													},
													"userProperties": [],
													"typeProperties": {
														"pipeline": {
															"referenceName": "PL_MD_Entity_Orchestrator",
															"type": "PipelineReference"
														},
														"waitOnCompletion": true,
														"parameters": {
															"EntityName": {
																"value": "@item().EntityName",
																"type": "Expression"
															},
															"BatchId": {
																"value": "@variables('v_BatchId')",
																"type": "Expression"
															},
															"ParentRunId": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"RunMode": {
																"value": "@pipeline().parameters.RunMode",
																"type": "Expression"
															},
															"WindowStart": {
																"value": "@pipeline().parameters.WindowStart",
																"type": "Expression"
															},
															"WindowEnd": {
																"value": "@pipeline().parameters.WindowEnd",
																"type": "Expression"
															}
														}
													}
												}
											]
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"RunMode": {
				"type": "String",
				"defaultValue": "NORMAL"
			},
			"WindowStart": {
				"type": "String"
			},
			"WindowEnd": {
				"type": "String"
			},
			"EntityBatchCount": {
				"type": "Int",
				"defaultValue": 4
			}
		},
		"variables": {
			"v_BatchId": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}