{
	"name": "PL_MD_Entity_Orchestrator",
	"properties": {
		"description": "Entity orchestrator: durable entity lease, deterministic window, full stage-level checkpoint resume, explicit ADF gates, source routing, no-data/with-data paths, quality/reconciliation/anomaly gates and safe watermark commit.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Validate_Entity_Config",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_ValidateEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Acquire_Entity_Lease",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Validate_Entity_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_AcquireEntityLease @EntityName=''',pipeline().parameters.EntityName,''', @PipelineRunId=''',pipeline().RunId,''', @BatchId=''',pipeline().parameters.BatchId,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Lease_Acquired",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Acquire_Entity_Lease",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Acquire_Entity_Lease').output.firstRow.LeaseDecision,'BLOCKED_ACTIVE'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Lease_Blocked_Run",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_LogLeaseBlockedRun",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"ParentRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"RunMode": {
										"value": {
											"value": "@pipeline().parameters.RunMode",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Run_Leased_Entity",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"RunMode": {
										"value": "@pipeline().parameters.RunMode",
										"type": "Expression"
									},
									"WindowStart": {
										"value": "@pipeline().parameters.WindowStart",
										"type": "Expression"
									},
									"WindowEnd": {
										"value": "@pipeline().parameters.WindowEnd",
										"type": "Expression"
									},
									"RecoveryMode": {
										"value": "@pipeline().parameters.RecoveryMode",
										"type": "Expression"
									},
									"ResumeFromStage": {
										"value": "@pipeline().parameters.ResumeFromStage",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"RunMode": {
				"type": "String",
				"defaultValue": "NORMAL"
			},
			"WindowStart": {
				"type": "String"
			},
			"WindowEnd": {
				"type": "String"
			},
			"RecoveryMode": {
				"type": "String",
				"defaultValue": "AUTO"
			},
			"ResumeFromStage": {
				"type": "String"
			}
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"HYBRID_ORCHESTRATION",
			"FULL_STAGE_RESUME",
			"MULTI_LAYER_IDEMPOTENCY",
			"CHECKPOINT_RECOVERY"
		]
	}
}