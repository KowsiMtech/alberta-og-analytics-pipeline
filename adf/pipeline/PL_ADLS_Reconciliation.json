				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "USE aer_synapse_db;\n\nSELECT COUNT(*) AS SilverRowCount\nFROM OPENROWSET(\n    BULK '/silver/clean/2026-08-27/*.parquet',\n    DATA_SOURCE = 'aer_adls',\n    FORMAT = 'PARQUET'\n) AS s;"
