{
	"name": "PL_ADLS_Reconciliation_INCREMENTAL",
	"properties": {
		"description": "FINAL V2 reconciliation consumes upstream counts only; no Bronze/Silver/Quarantine ADLS rescans. DQ logging failure is persisted by the common error handler. Instrumentation V3: reconciliation timing and PipelineRunDetail success/failure rows added; no ADLS recount introduced. V4: explicit StartTime, EndTime and DurationSeconds expressions passed to usp_LogPipelineRunDetail.",
		"activities": [
			{
				"name": "Set_Reconciliation_StartTime",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ReconciliationStartTime",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_SourceRowCount_FromParameter",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Reconciliation_StartTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_BronzeCount",
					"value": {
						"value": "@int(pipeline().parameters.SourceRowCount)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_SilverRowCount_FromParameter",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Reconciliation_StartTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_SilverCount",
					"value": {
						"value": "@int(pipeline().parameters.SilverRowCount)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_QuarantineRowCount_FromParameter",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Reconciliation_StartTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_QuarantineCount",
					"value": {
						"value": "@int(pipeline().parameters.QuarantineRowCount)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Log_DQ_BronzeEqualsSilverPlusQuarantine",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set_SourceRowCount_FromParameter",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_SilverRowCount_FromParameter",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_QuarantineRowCount_FromParameter",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_LogDataQualityResult]",
					"storedProcedureParameters": {
						"PipelineRunId": {
							"value": {
								"value": "@if(empty(pipeline().parameters.ParentRunId),pipeline().RunId,pipeline().parameters.ParentRunId)",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": "PL_ST37_to_Bronze_INCREMENTAL",
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"DatasetName": {
							"value": "ST37_WellList",
							"type": "String"
						},
						"RuleName": {
							"value": "BronzeEqualsSilverPlusQuarantine",
							"type": "String"
						},
						"RuleResult": {
							"value": {
								"value": "@if(equals(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),'PASS','FAIL')",
								"type": "Expression"
							},
							"type": "String"
						},
						"ExpectedValue": {
							"value": {
								"value": "@string(variables('v_BronzeCount'))",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActualValue": {
							"value": {
								"value": "@string(add(variables('v_SilverCount'),variables('v_QuarantineCount')))",
								"type": "Expression"
							},
							"type": "String"
						},
						"FailedRowCount": {
							"value": {
								"value": "@if(equals(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),0,if(greater(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),sub(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),sub(add(variables('v_SilverCount'),variables('v_QuarantineCount')),variables('v_BronzeCount'))))",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set_Reconciliation_EndTime_Success",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Log_DQ_BronzeEqualsSilverPlusQuarantine",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ReconciliationEndTime",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Reconciliation_EndTime_Failure",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Log_DQ_BronzeEqualsSilverPlusQuarantine",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ReconciliationEndTime",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Log_Reconciliation_Success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set_Reconciliation_EndTime_Success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_LogPipelineRunDetail]",
					"storedProcedureParameters": {
						"PipelineRunId": {
							"value": {
								"value": "@if(empty(pipeline().parameters.ParentRunId),pipeline().RunId,pipeline().parameters.ParentRunId)",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": "Bronze = Silver + Quarantine Reconciliation",
							"type": "String"
						},
						"ActivityType": {
							"value": "Reconciliation",
							"type": "String"
						},
						"Status": {
							"value": "SUCCESS",
							"type": "String"
						},
						"RowsRead": {
							"value": {
								"value": "@int(variables('v_BronzeCount'))",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"RowsWritten": {
							"value": {
								"value": "@add(int(variables('v_SilverCount')),int(variables('v_QuarantineCount')))",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"StartTime": {
							"value": {
								"value": "@variables('v_ReconciliationStartTime')",
								"type": "Expression"
							},
							"type": "String"
						},
						"EndTime": {
							"value": {
								"value": "@variables('v_ReconciliationEndTime')",
								"type": "Expression"
							},
							"type": "String"
						},
						"DurationSeconds": {
							"value": {
								"value": "@int(div(sub(ticks(variables('v_ReconciliationEndTime')),ticks(variables('v_ReconciliationStartTime'))),10000000))",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Log_Reconciliation_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set_Reconciliation_EndTime_Failure",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_LogPipelineRunDetail]",
					"storedProcedureParameters": {
						"PipelineRunId": {
							"value": {
								"value": "@if(empty(pipeline().parameters.ParentRunId),pipeline().RunId,pipeline().parameters.ParentRunId)",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": "Bronze = Silver + Quarantine Reconciliation",
							"type": "String"
						},
						"ActivityType": {
							"value": "Reconciliation",
							"type": "String"
						},
						"Status": {
							"value": "FAILED",
							"type": "String"
						},
						"RowsRead": {
							"value": {
								"value": "@int(variables('v_BronzeCount'))",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"RowsWritten": {
							"value": {
								"value": "@add(int(variables('v_SilverCount')),int(variables('v_QuarantineCount')))",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"StartTime": {
							"value": {
								"value": "@variables('v_ReconciliationStartTime')",
								"type": "Expression"
							},
							"type": "String"
						},
						"EndTime": {
							"value": {
								"value": "@variables('v_ReconciliationEndTime')",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorCode": {
							"value": {
								"value": "@activity('Log_DQ_BronzeEqualsSilverPlusQuarantine').error.errorCode",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Log_DQ_BronzeEqualsSilverPlusQuarantine').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"DurationSeconds": {
							"value": {
								"value": "@int(div(sub(ticks(variables('v_ReconciliationEndTime')),ticks(variables('v_ReconciliationStartTime'))),10000000))",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set_Reconciliation_ReturnValues",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Log_Reconciliation_Success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "SourceRowCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_BronzeCount'))"
							}
						},
						{
							"key": "SilverRowCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_SilverCount'))"
							}
						},
						{
							"key": "QuarantineRowCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_QuarantineCount'))"
							}
						},
						{
							"key": "WindowKey",
							"value": {
								"type": "Expression",
								"content": "@pipeline().parameters.WindowKey"
							}
						}
					],
					"setSystemVariable": true
				}
			},
			{
				"name": "Handle_Reconciliation_DQ_Failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Log_Reconciliation_Failure",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Common_Error_Handler",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"PipelineName": "{\"value\":{\"value\":\"@pipeline().Pipeline\",\"type\":\"Expression\"},\"type\":\"String\"}",
						"PipelineRunId": "{\"value\":{\"value\":\"@if(equals(pipeline().parameters.ParentRunId,''),pipeline().RunId,pipeline().parameters.ParentRunId)\",\"type\":\"Expression\"},\"type\":\"String\"}",
						"ActivityName": "{\"value\":\"BronzeEqualsSilverPlusQuarantine\",\"type\":\"String\"}",
						"ErrorMessage": "{\"value\":{\"value\":\"@activity('Log_DQ_BronzeEqualsSilverPlusQuarantine').error.message\",\"type\":\"Expression\"},\"type\":\"String\"}",
						"ErrorCode": "{\"value\":\"ST37_RECONCILIATION_FAILED\",\"type\":\"String\"}",
						"BatchId": "{\"value\":{\"value\":\"@pipeline().parameters.BatchId\",\"type\":\"Expression\"},\"type\":\"String\"}",
						"WindowKey": "{\"value\":{\"value\":\"@pipeline().parameters.WindowKey\",\"type\":\"Expression\"},\"type\":\"String\"}"
					}
				}
			},
			{
				"name": "Fail_Reconciliation_After_Handler",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Handle_Reconciliation_DQ_Failure",
						"dependencyConditions": [
							"Succeeded",
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Log_DQ_BronzeEqualsSilverPlusQuarantine').error.message",
						"type": "Expression"
					},
					"errorCode": "ST37_RECONCILIATION_FAILED"
				}
			}
		],
		"parameters": {
			"WindowKey": {
				"type": "string"
			},
			"ParentRunId": {
				"type": "string"
			},
			"BatchId": {
				"type": "string"
			},
			"SourceRowCount": {
				"type": "string",
				"defaultValue": "0"
			},
			"SilverRowCount": {
				"type": "string",
				"defaultValue": "0"
			},
			"QuarantineRowCount": {
				"type": "string",
				"defaultValue": "0"
			}
		},
		"variables": {
			"v_BronzeCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_SilverCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_QuarantineCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_ReconciliationStartTime": {
				"type": "String"
			},
			"v_ReconciliationEndTime": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Incremental_Load"
		},
		"annotations": [
			"Incremental",
			"WindowKey",
			"Reconciliation",
			"UpstreamMetrics",
			"NoStorageRecount",
			"CommonErrorHandler",
			"ExplicitTimingExpressionsV4",
			"ParentRunIdNullSafeV5"
		]
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}