{
	"name": "PL_ADLS_Reconciliation_INCREMENTAL",
	"properties": {
		"description": "Incremental reconciliation for the exact ST37 WindowKey. Returns current-batch Bronze/Silver/Quarantine counts; zero when ST37 has no rows. Bronze/Silver counts are wrapped in TRY/CATCH for runtime errors. Quarantine additionally uses a WITH schema clause since a 100%-clean batch means Synapse never writes a parquet file to that location, which fails schema inference before TRY/CATCH can catch it. Logs Bronze = Silver + Quarantine rule into control.DataQualityResult.",
		"activities": [
			{
				"name": "Reconcile_When_HasRows",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(toLower(pipeline().parameters.HasRows),'true')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "GetRowCount_Bronze",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Synapse_Serverless",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat('DECLARE @Cnt INT = 0; DECLARE @ErrMsg NVARCHAR(4000) = NULL; BEGIN TRY SELECT @Cnt = COUNT(*) FROM OPENROWSET(BULK ''/bronze/well/window=', pipeline().parameters.WindowKey, '/*.parquet'', DATA_SOURCE = ''aer_adls'', FORMAT = ''PARQUET'') AS b; END TRY BEGIN CATCH SET @Cnt = 0; SET @ErrMsg = ERROR_MESSAGE(); END CATCH SELECT @Cnt AS BronzeCount, @ErrMsg AS ErrorMsg;')",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "GetRowCount_Silver",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Synapse_Serverless",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat('DECLARE @Cnt INT = 0; DECLARE @ErrMsg NVARCHAR(4000) = NULL; BEGIN TRY SELECT @Cnt = COUNT(*) FROM OPENROWSET(BULK ''/silver/clean/window=', pipeline().parameters.WindowKey, '/*.parquet'', DATA_SOURCE = ''aer_adls'', FORMAT = ''PARQUET'') AS b; END TRY BEGIN CATCH SET @Cnt = 0; SET @ErrMsg = ERROR_MESSAGE(); END CATCH SELECT @Cnt AS SilverCount, @ErrMsg AS ErrorMsg;')",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "GetRowCount_Quarantine",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Synapse_Serverless",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat('DECLARE @Cnt INT = 0; DECLARE @ErrMsg NVARCHAR(4000) = NULL; BEGIN TRY SELECT @Cnt = COUNT(*) FROM OPENROWSET(BULK ''/quarantine/well_rejects/window=', pipeline().parameters.WindowKey, '/*.parquet'', DATA_SOURCE = ''aer_adls'', FORMAT = ''PARQUET'') WITH (WellID NVARCHAR(50)) AS b; END TRY BEGIN CATCH SET @Cnt = 0; SET @ErrMsg = ERROR_MESSAGE(); END CATCH SELECT @Cnt AS QuarantineCount, @ErrMsg AS ErrorMsg;')",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Set_BronzeCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GetRowCount_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_BronzeCount",
								"value": {
									"value": "@int(activity('GetRowCount_Bronze').output.resultSets[0].rows[0].BronzeCount)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_SilverCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GetRowCount_Silver",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_SilverCount",
								"value": {
									"value": "@int(activity('GetRowCount_Silver').output.resultSets[0].rows[0].SilverCount)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_QuarantineCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GetRowCount_Quarantine",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_QuarantineCount",
								"value": {
									"value": "@int(activity('GetRowCount_Quarantine').output.resultSets[0].rows[0].QuarantineCount)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Log_DQ_BronzeEqualsSilverPlusQuarantine",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Reconcile_When_HasRows",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_LogDataQualityResult]",
					"storedProcedureParameters": {
						"PipelineRunId": {
							"value": {
								"value": "@if(equals(pipeline().parameters.ParentRunId,''),pipeline().RunId,pipeline().parameters.ParentRunId)",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": "PL_ST37_to_Bronze_INCREMENTAL",
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"DatasetName": {
							"value": "ST37_WellList",
							"type": "String"
						},
						"RuleName": {
							"value": "BronzeEqualsSilverPlusQuarantine",
							"type": "String"
						},
						"RuleResult": {
							"value": {
								"value": "@if(equals(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),'PASS','FAIL')",
								"type": "Expression"
							},
							"type": "String"
						},
						"ExpectedValue": {
							"value": {
								"value": "@string(variables('v_BronzeCount'))",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActualValue": {
							"value": {
								"value": "@string(add(variables('v_SilverCount'),variables('v_QuarantineCount')))",
								"type": "Expression"
							},
							"type": "String"
						},
						"FailedRowCount": {
							"value": {
								"value": "@if(equals(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),0,if(greater(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),sub(variables('v_BronzeCount'),add(variables('v_SilverCount'),variables('v_QuarantineCount'))),sub(add(variables('v_SilverCount'),variables('v_QuarantineCount')),variables('v_BronzeCount'))))",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set_Reconciliation_ReturnValues",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Log_DQ_BronzeEqualsSilverPlusQuarantine",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "SourceRowCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_BronzeCount'))"
							}
						},
						{
							"key": "SilverRowCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_SilverCount'))"
							}
						},
						{
							"key": "QuarantineRowCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_QuarantineCount'))"
							}
						},
						{
							"key": "WindowKey",
							"value": {
								"type": "Expression",
								"content": "@pipeline().parameters.WindowKey"
							}
						}
					],
					"setSystemVariable": true
				}
			}
		],
		"parameters": {
			"WindowKey": {
				"type": "string"
			},
			"HasRows": {
				"type": "string",
				"defaultValue": "false"
			},
			"ParentRunId": {
				"type": "string"
			},
			"BatchId": {
				"type": "string"
			}
		},
		"variables": {
			"v_BronzeCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_SilverCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_QuarantineCount": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"folder": {
			"name": "Incremental_Load"
		},
		"annotations": [
			"Incremental",
			"WindowKey",
			"Reconciliation"
		]
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}