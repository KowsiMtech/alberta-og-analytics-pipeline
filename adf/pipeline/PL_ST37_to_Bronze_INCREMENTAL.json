{
	"name": "PL_ST37_to_Bronze_INCREMENTAL",
	"properties": {
		"description": "Incremental SQL Server WellList ingestion using a datetime watermark. First run uses ST37_DefaultLookbackDays. On every successful extract the timestamp watermark advances to the extraction end time, even when zero rows are returned. Returns WindowKey/HasRows to the master for downstream delta processing.",
		"activities": [
			{
				"name": "Lookup_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT LastSuccessfulLoadTimestamp FROM control.PipelineWatermark WHERE PipelineName = ''', pipeline().Pipeline, '''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Generic",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set_StartWatermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_StartWatermark",
					"value": {
						"value": "@if(or(equals(length(activity('Lookup_Watermark').output.value),0), equals(activity('Lookup_Watermark').output.value[0].LastSuccessfulLoadTimestamp,null)), formatDateTime(addDays(pipeline().TriggerTime, mul(pipeline().parameters.ST37_DefaultLookbackDays,-1)),'yyyy-MM-ddTHH:mm:ss'), formatDateTime(activity('Lookup_Watermark').output.value[0].LastSuccessfulLoadTimestamp,'yyyy-MM-ddTHH:mm:ss'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_EndWatermark",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_EndWatermark",
					"value": {
						"value": "@formatDateTime(pipeline().TriggerTime,'yyyy-MM-ddTHH:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_WindowKey",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_StartWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_EndWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_WindowKey",
					"value": {
						"value": "@concat(formatDateTime(variables('v_StartWatermark'),'yyyyMMddHHmmss'),'_',formatDateTime(variables('v_EndWatermark'),'yyyyMMddHHmmss'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy OnPremData Incremental",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set_WindowKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM [', pipeline().parameters.SourceSchema, '].[', pipeline().parameters.SourceTable, '] WHERE [', pipeline().parameters.WatermarkColumn, '] > CONVERT(datetime2(7), ''', variables('v_StartWatermark'), ''', 126) AND [', pipeline().parameters.WatermarkColumn, '] <= CONVERT(datetime2(7), ''', variables('v_EndWatermark'), ''', 126)')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_OnPrem_WellList",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Bronze_Well",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "@concat('bronze/well/window=', variables('v_WindowKey'))",
								"type": "Expression"
							},
							"FileName": {
								"value": "@concat(pipeline().parameters.SourceTable, '_', variables('v_WindowKey'), '.parquet')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Update_Watermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy OnPremData Incremental",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat('MERGE control.PipelineWatermark AS target USING (SELECT ''', pipeline().Pipeline, ''' AS PipelineName) AS src ON target.PipelineName = src.PipelineName WHEN MATCHED THEN UPDATE SET LastSuccessfulLoadTimestamp = CONVERT(datetime2(7), ''', variables('v_EndWatermark'), ''', 126), LastSuccessfulRunTime = SYSUTCDATETIME(), LastSuccessfulRunId = ''', pipeline().RunId, ''', LastUpdatedTime = SYSUTCDATETIME() WHEN NOT MATCHED THEN INSERT (PipelineName, LastSuccessfulLoadTimestamp, LastSuccessfulRunTime, LastSuccessfulRunId, LastUpdatedTime) VALUES (''', pipeline().Pipeline, ''', CONVERT(datetime2(7), ''', variables('v_EndWatermark'), ''', 126), SYSUTCDATETIME(), ''', pipeline().RunId, ''', SYSUTCDATETIME());')",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Set_PipelineReturnValue",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Update_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "StartWatermark",
							"value": {
								"type": "Expression",
								"content": "@variables('v_StartWatermark')"
							}
						},
						{
							"key": "EndWatermark",
							"value": {
								"type": "Expression",
								"content": "@variables('v_EndWatermark')"
							}
						},
						{
							"key": "WindowKey",
							"value": {
								"type": "Expression",
								"content": "@variables('v_WindowKey')"
							}
						},
						{
							"key": "HasRows",
							"value": {
								"type": "Expression",
								"content": "@string(greater(activity('Copy OnPremData Incremental').output.rowsCopied,0))"
							}
						}
					],
					"setSystemVariable": true
				}
			}
		],
		"parameters": {
			"SourceSchema": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"SourceTable": {
				"type": "string",
				"defaultValue": "WellList"
			},
			"WatermarkColumn": {
				"type": "string",
				"defaultValue": "LastModifiedDateTime"
			},
			"ST37_DefaultLookbackDays": {
				"type": "int",
				"defaultValue": 7
			}
		},
		"variables": {
			"v_StartWatermark": {
				"type": "String"
			},
			"v_EndWatermark": {
				"type": "String"
			},
			"v_WindowKey": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Incremental_Load"
		},
		"annotations": [
			"ST37",
			"WellList",
			"Incremental",
			"Watermark",
			"DeterministicBronzePath",
			"PipelineReturnValue"
		]
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}