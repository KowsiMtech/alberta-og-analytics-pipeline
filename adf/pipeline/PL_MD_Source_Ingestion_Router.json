{
	"name": "PL_MD_Source_Ingestion_Router",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Run_SOURCE_INGESTION",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Lookup_Config').output.firstRow.SourceType",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "SQL",
							"activities": [
								{
									"name": "Ingest_SQL",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_MD_SQL_Ingestion",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"EntityName": {
												"value": "@pipeline().parameters.EntityName",
												"type": "Expression"
											},
											"BatchId": {
												"value": "@pipeline().parameters.BatchId",
												"type": "Expression"
											},
											"ParentRunId": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											},
											"WindowKey": {
												"value": "@pipeline().parameters.WindowKey",
												"type": "Expression"
											},
											"ExtractionStart": {
												"value": "@pipeline().parameters.ExtractionStart",
												"type": "Expression"
											},
											"EndWatermark": {
												"value": "@pipeline().parameters.EndWatermark",
												"type": "Expression"
											},
											"RunMode": {
												"value": "@pipeline().parameters.RunMode",
												"type": "Expression"
											}
										}
									}
								}
							]
						},
						{
							"value": "REST_API",
							"activities": [
								{
									"name": "Ingest_REST",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_MD_REST_Ingestion",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"EntityName": {
												"value": "@pipeline().parameters.EntityName",
												"type": "Expression"
											},
											"BatchId": {
												"value": "@pipeline().parameters.BatchId",
												"type": "Expression"
											},
											"ParentRunId": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											},
											"WindowKey": {
												"value": "@pipeline().parameters.WindowKey",
												"type": "Expression"
											},
											"ExtractionStart": {
												"value": "@pipeline().parameters.ExtractionStart",
												"type": "Expression"
											},
											"EndWatermark": {
												"value": "@pipeline().parameters.EndWatermark",
												"type": "Expression"
											}
										}
									}
								}
							]
						},
						{
							"value": "__SKIP__",
							"activities": [
								{
									"name": "Skip_Source_Ingestion",
									"type": "Wait",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": 1
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Fail_Unsupported_Source",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Unsupported SourceType",
								"errorCode": "UNSUPPORTED_SOURCE"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"RunMode": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"StartWatermark": {
				"type": "String"
			},
			"EndWatermark": {
				"type": "String"
			},
			"ExtractionStart": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": []
	}
}