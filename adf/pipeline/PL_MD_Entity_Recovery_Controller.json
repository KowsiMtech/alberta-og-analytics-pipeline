{
	"name": "PL_MD_Entity_Recovery_Controller",
	"properties": {
		"description": "Hierarchical automatic recovery: stage retry -> deterministic incremental-window retry -> full batch retry. Every layer uses scoped max-retry policy and bounded exponential backoff with jitter.",
		"activities": [
			{
				"name": "Set_Initial_Recovery_Mode",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_CurrentRecoveryMode",
					"value": {
						"value": "@pipeline().parameters.RecoveryMode",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Initial_Resume_Stage",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Initial_Recovery_Mode",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_CurrentResumeFromStage",
					"value": {
						"value": "@pipeline().parameters.ResumeFromStage",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Until_Entity_Completed",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Set_Initial_Resume_Stage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_Done'),true)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Run_Entity_Attempt",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Entity_Orchestrator",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"RunMode": {
										"value": "@pipeline().parameters.RunMode",
										"type": "Expression"
									},
									"WindowStart": {
										"value": "@pipeline().parameters.WindowStart",
										"type": "Expression"
									},
									"WindowEnd": {
										"value": "@pipeline().parameters.WindowEnd",
										"type": "Expression"
									},
									"RecoveryMode": {
										"value": "@variables('v_CurrentRecoveryMode')",
										"type": "Expression"
									},
									"ResumeFromStage": {
										"value": "@variables('v_CurrentResumeFromStage')",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Mark_Entity_Done",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Run_Entity_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Done",
								"value": true
							}
						},
						{
							"name": "Capture_Entity_Error_Code",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Run_Entity_Attempt",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ErrorCode",
								"value": {
									"value": "@coalesce(activity('Run_Entity_Attempt').error.errorCode,activity('Run_Entity_Attempt').error.code,'ENTITY_ATTEMPT_FAILED')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Capture_Entity_Error_Message",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Capture_Entity_Error_Code",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ErrorMessage",
								"value": {
									"value": "@coalesce(activity('Run_Entity_Attempt').error.message,'Entity attempt failed')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Lookup_Latest_Failed_Stage",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Capture_Entity_Error_Message",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_GetLatestFailedStageV5 @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,'''')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Set_Failed_Stage",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Lookup_Latest_Failed_Stage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_FailedStage",
								"value": {
									"value": "@coalesce(activity('Lookup_Latest_Failed_Stage').output.firstRow.StageName,'UNKNOWN')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_WindowKey_For_Retry",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Failed_Stage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_WindowKey",
								"value": {
									"value": "@coalesce(activity('Lookup_Latest_Failed_Stage').output.firstRow.WindowKey,'')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Get_Hierarchical_Retry_Decision",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Set_WindowKey_For_Retry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_GetRecoveryRetryDecisionFinal @EntityName=''',pipeline().parameters.EntityName,''', @StageAttempt=',string(variables('v_StageAttempt')),', @IncrementalAttempt=',string(variables('v_IncrementalAttempt')),', @BatchAttempt=',string(variables('v_BatchAttempt')),', @FailedStage=''',replace(variables('v_FailedStage'),'''',''''''),''', @ErrorCode=''',replace(variables('v_ErrorCode'),'''',''''''),''', @ErrorMessage=N''',replace(variables('v_ErrorMessage'),'''',''''''),'''')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Set_Recovery_Action",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Get_Hierarchical_Retry_Decision",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Action",
								"value": {
									"value": "@activity('Get_Hierarchical_Retry_Decision').output.firstRow.RecoveryAction",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Recovery_Wait",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Recovery_Action",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_WaitSeconds",
								"value": {
									"value": "@int(activity('Get_Hierarchical_Retry_Decision').output.firstRow.ComputedWaitSeconds)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Next_Stage_Attempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Recovery_Wait",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_StageAttempt",
								"value": {
									"value": "@int(activity('Get_Hierarchical_Retry_Decision').output.firstRow.NextStageAttempt)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Next_Incremental_Attempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Next_Stage_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_IncrementalAttempt",
								"value": {
									"value": "@int(activity('Get_Hierarchical_Retry_Decision').output.firstRow.NextIncrementalAttempt)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Next_Batch_Attempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Next_Incremental_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_BatchAttempt",
								"value": {
									"value": "@int(activity('Get_Hierarchical_Retry_Decision').output.firstRow.NextBatchAttempt)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Next_Recovery_Mode",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Next_Batch_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_CurrentRecoveryMode",
								"value": {
									"value": "@string(activity('Get_Hierarchical_Retry_Decision').output.firstRow.NextRecoveryMode)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Next_Resume_Stage",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Next_Recovery_Mode",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_CurrentResumeFromStage",
								"value": {
									"value": "@string(activity('Get_Hierarchical_Retry_Decision').output.firstRow.NextResumeFromStage)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Record_Recovery_Decision",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Set_Next_Resume_Stage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordRecoveryDecisionFinal",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@variables('v_WindowKey')",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": {
											"value": "@variables('v_FailedStage')",
											"type": "Expression"
										},
										"type": "String"
									},
									"RecoveryAction": {
										"value": {
											"value": "@variables('v_Action')",
											"type": "Expression"
										},
										"type": "String"
									},
									"WaitSeconds": {
										"value": {
											"value": "@variables('v_WaitSeconds')",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"ErrorCode": {
										"value": {
											"value": "@variables('v_ErrorCode')",
											"type": "Expression"
										},
										"type": "String"
									},
									"ErrorMessage": {
										"value": {
											"value": "@variables('v_ErrorMessage')",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"ParentRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Wait_Recovery_Backoff",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Record_Recovery_Decision",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('v_WaitSeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Stop_On_Recovery_Exhausted",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_Recovery_Backoff",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Done",
								"value": {
									"value": "@or(equals(variables('v_Action'),'FAIL'),equals(variables('v_Action'),'RETRY_EXHAUSTED'))",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "2.00:00:00"
				}
			},
			{
				"name": "If_Recovery_Exhausted",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until_Entity_Completed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(variables('v_Action'),'FAIL'),equals(variables('v_Action'),'RETRY_EXHAUSTED'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Alert_Retry_Exhausted",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Common_Alert_Handler",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@variables('v_WindowKey')",
										"type": "Expression"
									},
									"AlertType": "RETRY_EXHAUSTED",
									"Severity": "CRITICAL",
									"ActivityName": {
										"value": "@variables('v_FailedStage')",
										"type": "Expression"
									},
									"Message": {
										"value": "@concat('All retry layers exhausted. stage=',variables('v_FailedStage'),' error=',variables('v_ErrorCode'),' ',variables('v_ErrorMessage'))",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Fail_Recovery_Exhausted",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Alert_Retry_Exhausted",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Recovery exhausted for ',pipeline().parameters.EntityName,' stage ',variables('v_FailedStage'),': ',variables('v_ErrorMessage'))",
									"type": "Expression"
								},
								"errorCode": "RECOVERY_RETRY_EXHAUSTED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"RunMode": {
				"type": "String",
				"defaultValue": "NORMAL"
			},
			"WindowStart": {
				"type": "String"
			},
			"WindowEnd": {
				"type": "String"
			},
			"RecoveryMode": {
				"type": "String",
				"defaultValue": "AUTO"
			},
			"ResumeFromStage": {
				"type": "String"
			}
		},
		"variables": {
			"v_Done": {
				"type": "Boolean",
				"defaultValue": false
			},
			"v_StageAttempt": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_IncrementalAttempt": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_BatchAttempt": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_CurrentRecoveryMode": {
				"type": "String",
				"defaultValue": "AUTO"
			},
			"v_CurrentResumeFromStage": {
				"type": "String"
			},
			"v_ErrorCode": {
				"type": "String"
			},
			"v_ErrorMessage": {
				"type": "String"
			},
			"v_FailedStage": {
				"type": "String",
				"defaultValue": "UNKNOWN"
			},
			"v_WindowKey": {
				"type": "String"
			},
			"v_Action": {
				"type": "String"
			},
			"v_WaitSeconds": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": []
	}
}