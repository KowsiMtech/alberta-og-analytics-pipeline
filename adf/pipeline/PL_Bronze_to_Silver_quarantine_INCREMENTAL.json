							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_ADLS_Quarantine_Folder",
									"type": "DatasetReference",
									"parameters": {
										"RunDate": {
											"value": "@concat('window=', pipeline().parameters.WindowKey)",
											"type": "Expression"
										}
									}
								},
								"enableLogging": false,
