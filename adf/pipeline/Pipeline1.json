{
	"name": "Pipeline1",
	"properties": {
		"description": "Fetches daily WTI oil prices from EIA REST API and loads into staging.OilPrice. API key fetched from Key Vault at runtime - zero hardcoded secrets.",
		"activities": [
			{
				"name": "Retry_GetEIAKey",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(variables('kv_success'),greaterOrEquals(variables('kv_attempt'),variables('kv_maxAttempts')))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "GetEIAKey",
							"description": "Fetch EIA API key from Azure Key Vault using Managed Identity",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:01:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": true
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat('https://aer-oilgas-kv.vault.azure.net/secrets/eia-api-key?api-version=7.0')",
									"type": "Expression"
								},
								"authentication": {
									"type": "MSI",
									"resource": "https://vault.azure.net"
								}
							}
						},
						{
							"name": "KV_CaptureEIAKey",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GetEIAKey",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_EIA_ApiKey",
								"value": {
									"value": "@activity('GetEIAKey').output.value",
									"type": "Expression"
								}
							}
						},
						{
							"name": "kv_MarkSuccess",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "KV_CaptureEIAKey",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "kv_success",
								"value": true
							}
						},
						{
							"name": "kv_WaitBeforeRetry",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "GetEIAKey",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('kv_delaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "kv_CalcNextDelay",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "kv_WaitBeforeRetry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "kv_nextDelaySeconds",
								"value": {
									"value": "@if(greater(mul(variables('kv_delaySeconds'),2),variables('kv_maxDelaySeconds')),variables('kv_maxDelaySeconds'),mul(variables('kv_delaySeconds'),2))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "kv_ApplyNextDelay",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "kv_CalcNextDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "kv_delaySeconds",
								"value": {
									"value": "@variables('kv_nextDelaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "kv_CalcNextAttempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "kv_ApplyNextDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "kv_nextAttempt",
								"value": {
									"value": "@add(variables('kv_attempt'),1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "kv_ApplyNextAttempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "kv_CalcNextAttempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "kv_attempt",
								"value": {
									"value": "@variables('kv_nextAttempt')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.01:00:00"
				}
			},
			{
				"name": "Check_GetEIAKey_Success",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Retry_GetEIAKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@variables('kv_success')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Check_GetEIAKey_Success",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Unable to retrieve the EIA API key from Key Vault after all configured attempts.",
								"errorCode": "EIA_KEY_RETRY_EXHAUSTED"
							}
						}
					]
				}
			},
			{
				"name": "Retry_Copy_EIA_to_SQL",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Check_GetEIAKey_Success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(variables('sql_success'),greaterOrEquals(variables('sql_attempt'),variables('sql_maxAttempts')))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy EIA to SQL",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"additionalColumns": [
										{
											"name": "IngestionDate",
											"value": {
												"value": "@utcnow()",
												"type": "Expression"
											}
										}
									],
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": "TRUNCATE TABLE staging.OilPrice",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "['period']"
											},
											"sink": {
												"name": "period",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['value']"
											},
											"sink": {
												"name": "value",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['series-description']"
											},
											"sink": {
												"name": "series-description",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['product-name']"
											},
											"sink": {
												"name": "product-name",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['units']"
											},
											"sink": {
												"name": "units",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['IngestionDate']"
											},
											"sink": {
												"name": "IngestionDate"
											}
										}
									],
									"collectionReference": "$['response']['data']",
									"mapComplexValuesToString": false
								}
							},
							"inputs": [
								{
									"referenceName": "DS_EIA_REST_Source",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": "@concat('v2/petroleum/pri/spt/data/?api_key=', variables('v_EIA_ApiKey'), '&frequency=daily&data[0]=value&facets[series][]=RWTC&sort[0][column]=period&sort[0][direction]=desc&length=5000')"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_AzureSQL_OilPrice_Sink",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "sql_MarkSuccess",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy EIA to SQL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "sql_success",
								"value": true
							}
						},
						{
							"name": "sql_WaitBeforeRetry",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Copy EIA to SQL",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('sql_delaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "sql_CalcNextDelay",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "sql_WaitBeforeRetry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "sql_nextDelaySeconds",
								"value": {
									"value": "@if(greater(mul(variables('sql_delaySeconds'),2),variables('sql_maxDelaySeconds')),variables('sql_maxDelaySeconds'),mul(variables('sql_delaySeconds'),2))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "sql_ApplyNextDelay",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "sql_CalcNextDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "sql_delaySeconds",
								"value": {
									"value": "@variables('sql_nextDelaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "sql_CalcNextAttempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "sql_ApplyNextDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "sql_nextAttempt",
								"value": {
									"value": "@add(variables('sql_attempt'),1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "sql_ApplyNextAttempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "sql_CalcNextAttempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "sql_attempt",
								"value": {
									"value": "@variables('sql_nextAttempt')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.01:00:00"
				}
			},
			{
				"name": "Check_SQL_Copy_Success",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Retry_Copy_EIA_to_SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@variables('sql_success')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Check_SQL_Copy_Success",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "EIA REST-to-SQL copy failed after all configured attempts.",
								"errorCode": "EIA_SQL_COPY_RETRY_EXHAUSTED"
							}
						}
					]
				}
			},
			{
				"name": "Retry_Copy_EIA_to_ADLS",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Check_GetEIAKey_Success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(variables('adls_success'),greaterOrEquals(variables('adls_attempt'),variables('adls_maxAttempts')))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy EIA Data to Adls",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"additionalColumns": [
										{
											"name": "IngestionDate",
											"value": {
												"value": "@utcnow()",
												"type": "Expression"
											}
										}
									],
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "['period']"
											},
											"sink": {
												"name": "period",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['value']"
											},
											"sink": {
												"name": "value",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['series-description']"
											},
											"sink": {
												"name": "series-description",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['product-name']"
											},
											"sink": {
												"name": "product-name",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['units']"
											},
											"sink": {
												"name": "units",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['response']['IngestionDate']"
											},
											"sink": {
												"name": "IngestionDate",
												"type": "DateTime"
											}
										}
									],
									"collectionReference": "$['response']['data']"
								}
							},
							"inputs": [
								{
									"referenceName": "DS_EIA_REST_Source",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": "@concat(   'v2/petroleum/pri/spt/data/?api_key=',   variables('v_EIA_ApiKey'),   '&frequency=daily&data[0]=value&facets[series][]=RWTC' )"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_OilPrice",
									"type": "DatasetReference",
									"parameters": {
										"FolderPath": "@concat('bronze/oilprice/', formatDateTime(utcnow(),'yyyy-MM-dd'))",
										"FileName": "@concat('OilPrice_', formatDateTime(utcnow(),'yyyy-MM-dd'), '.parquet')"
									}
								}
							]
						},
						{
							"name": "adls_MarkSuccess",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy EIA Data to Adls",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "adls_success",
								"value": true
							}
						},
						{
							"name": "adls_WaitBeforeRetry",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Copy EIA Data to Adls",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('adls_delaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "adls_CalcNextDelay",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "adls_WaitBeforeRetry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "adls_nextDelaySeconds",
								"value": {
									"value": "@if(greater(mul(variables('adls_delaySeconds'),2),variables('adls_maxDelaySeconds')),variables('adls_maxDelaySeconds'),mul(variables('adls_delaySeconds'),2))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "adls_ApplyNextDelay",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "adls_CalcNextDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "adls_delaySeconds",
								"value": {
									"value": "@variables('adls_nextDelaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "adls_CalcNextAttempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "adls_ApplyNextDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "adls_nextAttempt",
								"value": {
									"value": "@add(variables('adls_attempt'),1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "adls_ApplyNextAttempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "adls_CalcNextAttempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "adls_attempt",
								"value": {
									"value": "@variables('adls_nextAttempt')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.01:00:00"
				}
			},
			{
				"name": "Check_ADLS_Copy_Success",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Retry_Copy_EIA_to_ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@variables('adls_success')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Check_ADLS_Copy_Success",
							"type": "Fail",
							"dependsOn": [],
