{
	"name": "PL_MD_Archive",
	"properties": {
		"description": "Metadata-driven daily Gold archive; restores the original project archive behavior without hardcoding objects in the orchestration.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set_Archive_Date",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ArchiveDate",
					"value": {
						"value": "@formatDateTime(utcnow(),'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If_Archive_Enabled",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set_Archive_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Lookup_Config').output.firstRow.ArchiveEnabled,true)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Archive_Disabled",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "ARCHIVE",
										"type": "String"
									},
									"Status": {
										"value": "SKIPPED",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Lookup_Archive_Objects",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT ArchiveObjectName,SourceQuery,TargetFolderTemplate FROM control.ArchiveObjectConfig WHERE EntityName=''',pipeline().parameters.EntityName,''' AND IsActive=1 ORDER BY Priority')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "Set_Archive_Objects",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Lookup_Archive_Objects",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ArchiveObjects",
								"value": {
									"value": "@activity('Lookup_Archive_Objects').output.value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ForEach_Archive_Object",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "If_Archive_Enabled",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('v_ArchiveObjects')",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 4,
					"activities": [
						{
							"name": "Archive_One_Object",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Archive_Item",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"ArchiveObject": {
										"value": "@string(item())",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"variables": {
			"v_ArchiveDate": {
				"type": "String"
			},
			"v_ArchiveObjects": {
				"type": "Array",
				"defaultValue": []
			}
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}