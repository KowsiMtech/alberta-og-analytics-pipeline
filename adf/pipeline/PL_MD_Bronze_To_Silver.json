{
	"name": "PL_MD_Bronze_To_Silver",
	"properties": {
		"description": "Entity-specific transformation, quarantine classification, and explicit counts. ST37 preserves LastModifiedDateTime for later overlap dedup.",
		"activities": [
			{
				"name": "Lookup_Transform",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT ScriptTemplate FROM control.EntityTransformScript WHERE EntityName=''',pipeline().parameters.EntityName,''' AND StageName=''BRONZE_TO_SILVER'' AND IsActive=1')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Run_Entity_BronzeToSilver",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Lookup_Transform",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_Synapse_Serverless",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@replace(replace(activity('Lookup_Transform').output.firstRow.ScriptTemplate,'{{WindowKey}}',pipeline().parameters.WindowKey),'{{BatchId}}',pipeline().parameters.BatchId)",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Set_SilverCount",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Run_Entity_BronzeToSilver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_SilverCount",
					"value": {
						"value": "@int(activity('Run_Entity_BronzeToSilver').output.resultSets[0].rows[0].SilverCount)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_QuarantineCount",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Run_Entity_BronzeToSilver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_QuarantineCount",
					"value": {
						"value": "@int(activity('Run_Entity_BronzeToSilver').output.resultSets[0].rows[0].QuarantineCount)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Log_BronzeToSilver_Stage",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set_SilverCount",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_QuarantineCount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_RecordStage",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"StageName": {
							"value": "BRONZE_TO_SILVER",
							"type": "String"
						},
						"Status": {
							"value": "SUCCESS",
							"type": "String"
						},
						"RowCount": {
							"value": {
								"value": "@variables('v_SilverCount')",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"Detail": {
							"value": {
								"value": "@concat('quarantine=',string(variables('v_QuarantineCount')))",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Return_Counts",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Log_BronzeToSilver_Stage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "SilverCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_SilverCount'))"
							}
						},
						{
							"key": "QuarantineCount",
							"value": {
								"type": "Expression",
								"content": "@string(variables('v_QuarantineCount'))"
							}
						}
					],
					"setSystemVariable": true
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"variables": {
			"v_SilverCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_QuarantineCount": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}