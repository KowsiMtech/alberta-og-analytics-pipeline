{
	"name": "PL_Archive_Gold_to_ADLS",
	"properties": {
		"description": "Gold archive copies with one reusable common-error-handler call per Copy failure. The common handler logs and fails, so separate Fail_After_* activities are intentionally removed. Instrumentation V3: one archive-stage success detail row with aggregate rows and elapsed timing; per-copy common error handlers retained. V4: explicit StartTime, EndTime and DurationSeconds expressions passed to usp_LogPipelineRunDetail. Canonicalized ExecutePipeline parameters for PL_Common_Error_Handler; null-safe ParentRunId; resilient failure-handler dependency where applicable.",
		"activities": [
			{
				"name": "Set_Archive_StartTime",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ArchiveStartTime",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
