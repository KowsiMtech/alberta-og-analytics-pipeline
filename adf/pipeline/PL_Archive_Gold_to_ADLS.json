{
	"name": "PL_Archive_Gold_to_ADLS",
	"properties": {
		"description": "Gold daily snapshot archive guarded to run at most once per UTC day. Existing full-current Gold snapshot queries are preserved; repeated incremental Master runs on the same UTC day skip the heavy archive copy. Failure handling and aggregate PipelineRunDetail logging are preserved inside the archive branch.",
		"activities": [
			{
				"name": "Check_Archive_Already_Done_Today",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT CAST(CASE WHEN EXISTS (SELECT 1 FROM control.PipelineRunDetail WHERE PipelineName = 'PL_Archive_Gold_to_ADLS' AND ActivityName = 'Archive Gold to ADLS' AND Status = 'SUCCESS' AND CreatedAt >= CONVERT(date, SYSUTCDATETIME()) AND CreatedAt < DATEADD(day,1,CONVERT(date,SYSUTCDATETIME()))) THEN 1 ELSE 0 END AS INT) AS AlreadyArchivedToday",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Generic",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Run_Archive_Only_Once_Per_UTC_Day",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check_Archive_Already_Done_Today",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(int(activity('Check_Archive_Already_Done_Today').output.firstRow.AlreadyArchivedToday),0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set_Archive_StartTime",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ArchiveStartTime",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Archive_DimOperator",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Set_Archive_StartTime",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "SELECT * FROM gold.Dim_Operator WHERE Is_Current=1",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_AzureSQL_Gold",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Archive_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"FolderPath": {
											"value": "gold/dim_operator/@{formatDateTime(utcNow(), 'yyyy-MM-dd')}/",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Handle_Failure_Archive_DimOperator",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Archive_DimOperator",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Common_Error_Handler",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"PipelineName": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"PipelineRunId": {
										"value": "@if(empty(pipeline().parameters.ParentRunId),pipeline().RunId,pipeline().parameters.ParentRunId)",
										"type": "Expression"
									},
									"ActivityName": "Archive_DimOperator",
									"ErrorMessage": {
										"value": "@activity('Archive_DimOperator').error.message",
										"type": "Expression"
									},
									"ErrorCode": "GOLD_ARCHIVE_ARCHIVE_DIMOPERATOR_FAILED",
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									}
								}
							}
						},
