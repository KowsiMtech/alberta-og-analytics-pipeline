{
	"name": "PL_MD_Common_Error_Handler",
	"properties": {
		"description": "Central final-failure classification, logging, run closure, alert, and fail propagation.",
		"activities": [
			{
				"name": "Lookup_Error_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT RetryPolicyName FROM control.EntityConfig WHERE EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Classify_Final_Error",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup_Error_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetRetryDecision @PolicyName=''',coalesce(activity('Lookup_Error_Config').output.firstRow.RetryPolicyName,'DEFAULT'),''', @ErrorCode=''',replace(pipeline().parameters.ErrorCode,'''',''''''),''', @ErrorMessage=N''',replace(pipeline().parameters.ErrorMessage,'''',''''''),''', @RetryAttempt=999')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Log_Error",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Classify_Final_Error",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_LogError",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineName": {
							"value": {
								"value": "@pipeline().parameters.PipelineName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": {
								"value": "@pipeline().parameters.ActivityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorCode": {
							"value": {
								"value": "@pipeline().parameters.ErrorCode",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": {
								"value": "@pipeline().parameters.ErrorMessage",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorCategory": {
							"value": {
								"value": "@activity('Classify_Final_Error').output.firstRow.ErrorCategory",
								"type": "Expression"
							},
							"type": "String"
						},
						"IsRetryable": {
							"value": {
								"value": "@activity('Classify_Final_Error').output.firstRow.IsRetryable",
								"type": "Expression"
							},
							"type": "Boolean"
						},
						"RetryAttempt": {
							"value": 0,
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Fail_Durable_Stage_Checkpoint",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Log_Error",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_FailStage",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"StageName": {
							"value": {
								"value": "@if(empty(pipeline().parameters.StageName),pipeline().parameters.ActivityName,pipeline().parameters.StageName)",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorCode": {
							"value": {
								"value": "@pipeline().parameters.ErrorCode",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": {
								"value": "@pipeline().parameters.ErrorMessage",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Log_Stage_Failed",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Fail_Durable_Stage_Checkpoint",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_RecordStage",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"StageName": {
							"value": {
								"value": "@pipeline().parameters.ActivityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"Status": {
							"value": "FAILED",
							"type": "String"
						},
						"Detail": {
							"value": {
								"value": "@pipeline().parameters.ErrorMessage",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "End_Run_Failed",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Log_Stage_Failed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_EndPipelineRun",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"Status": {
							"value": "FAILED",
							"type": "String"
						},
						"DataLoadStatus": {
							"value": "FAILED",
							"type": "String"
						},
						"ErrorCode": {
							"value": {
								"value": "@pipeline().parameters.ErrorCode",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorMessage": {
							"value": {
								"value": "@pipeline().parameters.ErrorMessage",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Release_Entity_Lease_On_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "End_Run_Failed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_ReleaseEntityLease",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Alert_Failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Release_Entity_Lease_On_Failure",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_MD_Common_Alert_Handler",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"EntityName": {
							"value": "@pipeline().parameters.EntityName",
							"type": "Expression"
						},
						"BatchId": {
							"value": "@pipeline().parameters.BatchId",
							"type": "Expression"
						},
						"ParentRunId": {
							"value": "@pipeline().parameters.ParentRunId",
							"type": "Expression"
						},
						"WindowKey": {
							"value": "@pipeline().parameters.WindowKey",
							"type": "Expression"
						},
						"AlertType": "PIPELINE_FAILURE",
						"Severity": "CRITICAL",
						"ActivityName": {
							"value": "@pipeline().parameters.ActivityName",
							"type": "Expression"
						},
						"Message": {
							"value": "@pipeline().parameters.ErrorMessage",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Fail_Handled_Error",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Alert_Failure",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@pipeline().parameters.ErrorMessage",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@pipeline().parameters.ErrorCode",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"PipelineName": {
				"type": "String"
			},
			"ActivityName": {
				"type": "String"
			},
			"ErrorCode": {
				"type": "String"
			},
			"ErrorMessage": {
				"type": "String"
			},
			"StageName": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}