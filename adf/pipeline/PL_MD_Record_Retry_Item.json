{
	"name": "PL_MD_Record_Retry_Item",
	"properties": {
		"description": "Retries one record-addressable work item with record-scope exponential backoff and max retry/dead-letter handling.",
		"activities": [
			{
				"name": "Set_Initial_Record_Attempt",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_Attempt",
					"value": {
						"value": "@pipeline().parameters.InitialAttempt",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Execute_Record_Handler",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Set_Initial_Record_Attempt",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_ExecuteRecordRetry @RecordRetryId=',string(pipeline().parameters.RecordRetryId))",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Get_Record_Retry_Action",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Execute_Record_Handler",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetRecordRetryAction @EntityName=''',pipeline().parameters.EntityName,''', @AttemptNo=',string(variables('v_Attempt')),', @Result=''',activity('Execute_Record_Handler').output.firstRow.Result,''', @ErrorCode=''',replace(coalesce(activity('Execute_Record_Handler').output.firstRow.ErrorCode,''),'''',''''''),''', @ErrorMessage=N''',replace(coalesce(activity('Execute_Record_Handler').output.firstRow.ErrorMessage,''),'''',''''''),'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Switch_Record_Action",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Get_Record_Retry_Action",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Get_Record_Retry_Action').output.firstRow.Action",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "COMPLETE",
							"activities": [
								{
									"name": "Complete_Record",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "control.usp_CompleteRecordRetry",
										"storedProcedureParameters": {
											"RecordRetryId": {
												"value": {
													"value": "@pipeline().parameters.RecordRetryId",
													"type": "Expression"
												},
												"type": "Int64"
											},
											"PipelineRunId": {
												"value": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						},
						{
							"value": "SCHEDULE",
							"activities": [
								{
									"name": "Schedule_Record_Retry",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "control.usp_ScheduleRecordRetry",
										"storedProcedureParameters": {
											"RecordRetryId": {
												"value": {
													"value": "@pipeline().parameters.RecordRetryId",
													"type": "Expression"
												},
												"type": "Int64"
											},
											"PipelineRunId": {
												"value": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"type": "String"
											},
											"AttemptNo": {
												"value": {
													"value": "@int(activity('Get_Record_Retry_Action').output.firstRow.NextAttemptNo)",
													"type": "Expression"
												},
												"type": "Int"
											},
											"WaitSeconds": {
												"value": {
													"value": "@int(activity('Get_Record_Retry_Action').output.firstRow.ComputedWaitSeconds)",
													"type": "Expression"
												},
												"type": "Int"
											},
											"ErrorCode": {
												"value": {
													"value": "@string(activity('Get_Record_Retry_Action').output.firstRow.ErrorCode)",
													"type": "Expression"
												},
												"type": "String"
											},
											"ErrorMessage": {
												"value": {
													"value": "@string(activity('Get_Record_Retry_Action').output.firstRow.ErrorMessage)",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						},
						{
							"value": "DEAD_LETTER",
							"activities": [
								{
									"name": "DeadLetter_Record",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "control.usp_DeadLetterRecordRetry",
										"storedProcedureParameters": {
											"RecordRetryId": {
												"value": {
													"value": "@pipeline().parameters.RecordRetryId",
													"type": "Expression"
												},
												"type": "Int64"
											},
											"PipelineRunId": {
												"value": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"type": "String"
											},
											"AttemptNo": {
												"value": {
													"value": "@int(activity('Get_Record_Retry_Action').output.firstRow.NextAttemptNo)",
													"type": "Expression"
												},
												"type": "Int"
											},
											"ErrorCode": {
												"value": {
													"value": "@string(activity('Get_Record_Retry_Action').output.firstRow.ErrorCode)",
													"type": "Expression"
												},
												"type": "String"
											},
											"ErrorMessage": {
												"value": {
													"value": "@string(activity('Get_Record_Retry_Action').output.firstRow.ErrorMessage)",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Alert_Invalid_Record_Retry_Action",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Common_Alert_Handler",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"AlertType": "INVALID_RECORD_RETRY_ACTION",
									"Severity": "CRITICAL",
									"ActivityName": "Switch_Record_Action",
									"Message": {
										"value": "@concat('Unexpected record retry action: ',string(activity('Get_Record_Retry_Action').output.firstRow.Action))",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Fail_Invalid_Record_Retry_Action",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Alert_Invalid_Record_Retry_Action",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Unexpected record retry action: ',string(activity('Get_Record_Retry_Action').output.firstRow.Action))",
									"type": "Expression"
								},
								"errorCode": "INVALID_RECORD_RETRY_ACTION"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"RecordRetryId": {
				"type": "Int"
			},
			"BatchId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"StageName": {
				"type": "String",
				"defaultValue": "DQ_ENGINE"
			},
			"RecordKey": {
				"type": "String"
			},
			"InitialAttempt": {
				"type": "Int",
				"defaultValue": 0
			}
		},
		"variables": {
			"v_Done": {
				"type": "Boolean",
				"defaultValue": false
			},
			"v_Attempt": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_Result": {
				"type": "String"
			},
			"v_ErrorCode": {
				"type": "String"
			},
			"v_ErrorMessage": {
				"type": "String"
			},
			"v_Decision": {
				"type": "String"
			},
			"v_Wait": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": []
	}
}