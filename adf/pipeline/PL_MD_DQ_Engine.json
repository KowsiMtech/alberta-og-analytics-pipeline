{
	"name": "PL_MD_DQ_Engine",
	"properties": {
		"description": "Metadata DQ evaluates standardized staging data using final structural/business/domain/reference rules, persists rule evidence, optionally queues record retries, and gates Gold on severe failures.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_DQ_Enabled",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Lookup_Config').output.firstRow.DQEnabled,true)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_DQ_Skipped",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "DQ_ENGINE",
										"type": "String"
									},
									"Status": {
										"value": "SKIPPED",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Run_Metadata_DQ",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_RunDQForSqlTableFinal @EntityName=''',pipeline().parameters.EntityName,''', @TargetSchema=''',activity('Lookup_Config').output.firstRow.StagingSchema,''', @TargetTable=''',activity('Lookup_Config').output.firstRow.StagingTable,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,'''')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Queue_Record_Level_Retries",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Run_Metadata_DQ",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_QueueDQRecordRetriesV5 @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,''', @TargetSchema=''',activity('Lookup_Config').output.firstRow.StagingSchema,''', @TargetTable=''',activity('Lookup_Config').output.firstRow.StagingTable,'''')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Run_Record_Retry_Worker",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Queue_Record_Level_Retries",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"MaxRecordsPerRun": 100,
									"BatchCount": 10
								}
							}
						},
						{
							"name": "Get_DQ_Summary",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Run_Record_Retry_Worker",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_GetDQSummary @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,'''')",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Set_DQStatus",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Get_DQ_Summary",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_DQStatus",
								"value": {
									"value": "@activity('Get_DQ_Summary').output.firstRow.DQStatus",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Update_DQ_Status",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Set_DQStatus",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_UpdateRunMetricsV2",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"DQStatus": {
										"value": {
											"value": "@variables('v_DQStatus')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "If_DQ_Failed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "If_DQ_Enabled",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(activity('Lookup_Config').output.firstRow.DQEnabled,true),equals(variables('v_DQStatus'),'FAIL'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_DQ_Passed",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "DQ_ENGINE",
										"type": "String"
									},
									"Status": {
										"value": {
											"value": "@if(equals(variables('v_DQStatus'),'WARN'),'WARNING','SUCCESS')",
											"type": "Expression"
										},
										"type": "String"
									},
									"Detail": {
										"value": {
											"value": "@variables('v_DQStatus')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Alert_DQ_Failure",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_MD_Common_Alert_Handler",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"AlertType": "DQ_FAILURE",
									"Severity": "CRITICAL",
									"ActivityName": "DQ_ENGINE",
									"Message": "One or more ERROR/CRITICAL metadata DQ rules failed."
								}
							}
						},
						{
							"name": "Fail_DQ",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Alert_DQ_Failure",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Metadata DQ failed",
								"errorCode": "DQ_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"variables": {
			"v_DQStatus": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED",
			"SILVER_QUALITY_V7"
		]
	}
}