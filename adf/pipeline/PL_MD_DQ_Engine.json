{
	"name": "PL_MD_DQ_Engine",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Run_DQ",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_RunDQForSqlTable @EntityName=''',pipeline().parameters.EntityName,''', @TargetSchema=''',activity('Lookup_Config').output.firstRow.StagingSchema,''', @TargetTable=''',activity('Lookup_Config').output.firstRow.StagingTable,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @WindowKey=''',pipeline().parameters.WindowKey,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven_Pipeline"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ST37_SEEDED"
		]
	}
}