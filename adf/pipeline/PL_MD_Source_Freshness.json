{
	"name": "PL_MD_Source_Freshness",
	"properties": {
		"description": "Source freshness is evaluated separately from data presence; stale source alerts do not masquerade as NO_DATA.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Freshness_Enabled",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(activity('Lookup_Config').output.firstRow.FreshnessCheckEnabled,true),equals(activity('Lookup_Config').output.firstRow.SourceType,'SQL'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Freshness_Skipped",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "SOURCE_FRESHNESS",
										"type": "String"
									},
									"Status": {
										"value": "SKIPPED",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Lookup_Source_Latest_Time",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT MAX(',activity('Lookup_Config').output.firstRow.WatermarkColumn,') ActualLatestTime FROM ',activity('Lookup_Config').output.firstRow.SourceSchema,'.',activity('Lookup_Config').output.firstRow.SourceObject)",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_SourceSql",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Evaluate_Freshness",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Lookup_Source_Latest_Time",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_EvaluateFreshness @EntityName=''',pipeline().parameters.EntityName,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @ActualLatestTime=',if(empty(activity('Lookup_Source_Latest_Time').output.firstRow.ActualLatestTime),'NULL',concat('''',activity('Lookup_Source_Latest_Time').output.firstRow.ActualLatestTime,'''')))",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Set_FreshnessStatus",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Evaluate_Freshness",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_FreshnessStatus",
								"value": {
									"value": "@activity('Evaluate_Freshness').output.firstRow.FreshnessStatus",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Update_Freshness_Status",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Set_FreshnessStatus",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_UpdateRunMetricsV2",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"FreshnessStatus": {
										"value": {
											"value": "@variables('v_FreshnessStatus')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "If_Source_Stale",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Update_Freshness_Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(variables('v_FreshnessStatus'),'STALE')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Log_Freshness_OK",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "control.usp_RecordStage",
											"storedProcedureParameters": {
												"EntityName": {
													"value": {
														"value": "@pipeline().parameters.EntityName",
														"type": "Expression"
													},
													"type": "String"
												},
												"PipelineRunId": {
													"value": {
														"value": "@pipeline().parameters.ParentRunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"BatchId": {
													"value": {
														"value": "@pipeline().parameters.BatchId",
														"type": "Expression"
													},
													"type": "String"
												},
												"WindowKey": {
													"value": {
														"value": "@pipeline().parameters.WindowKey",
														"type": "Expression"
													},
													"type": "String"
												},
												"StageName": {
													"value": "SOURCE_FRESHNESS",
													"type": "String"
												},
												"Status": {
													"value": "SUCCESS",
													"type": "String"
												},
												"Detail": {
													"value": {
														"value": "@variables('v_FreshnessStatus')",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_AzureSQL",
											"type": "LinkedServiceReference"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Alert_Source_Stale",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_MD_Common_Alert_Handler",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"EntityName": {
													"value": "@pipeline().parameters.EntityName",
													"type": "Expression"
												},
												"BatchId": {
													"value": "@pipeline().parameters.BatchId",
													"type": "Expression"
												},
												"ParentRunId": {
													"value": "@pipeline().parameters.ParentRunId",
													"type": "Expression"
												},
												"WindowKey": {
													"value": "@pipeline().parameters.WindowKey",
													"type": "Expression"
												},
												"AlertType": "SOURCE_STALE",
												"Severity": "WARNING",
												"ActivityName": "SOURCE_FRESHNESS",
												"Message": "Source latest watermark is older than configured freshness threshold."
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			}
		},
		"variables": {
			"v_FreshnessStatus": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven_Pipeline"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}