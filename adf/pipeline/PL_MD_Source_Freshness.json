{
	"name": "PL_MD_Source_Freshness",
	"properties": {
		"description": "Hybrid source freshness: SQL computes/persists status, severity, lag and true consecutive-stale streak; ADF visibly decides alert/continue/fail.",
		"activities": [
			{
				"name": "Lookup_Freshness_Policy",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetSourceFreshnessConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Freshness_Enabled",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Freshness_Policy",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Lookup_Freshness_Policy').output.firstRow.IsEnabled,true)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Freshness_Check_Disabled",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordStage",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"StageName": {
										"value": "SOURCE_FRESHNESS",
										"type": "String"
									},
									"Status": {
										"value": "SKIPPED",
										"type": "String"
									},
									"Detail": {
										"value": "Freshness check disabled by metadata policy.",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Switch_Freshness_SourceType",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "If_Freshness_Enabled",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@if(equals(activity('Lookup_Freshness_Policy').output.firstRow.IsEnabled,true),activity('Lookup_Freshness_Policy').output.firstRow.SourceType,'__SKIP__')",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "SQL",
							"activities": [
								{
									"name": "Lookup_SQL_Source_Latest_Time",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlSource",
											"sqlReaderQuery": {
												"value": "@concat('SELECT MAX([', activity('Lookup_Freshness_Policy').output.firstRow.WatermarkColumn, ']) AS ActualLatestTime FROM [', activity('Lookup_Freshness_Policy').output.firstRow.SourceSchema, '].[', activity('Lookup_Freshness_Policy').output.firstRow.SourceObject, ']')",
												"type": "Expression"
											},
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_MD_SourceSql",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@activity('Lookup_Freshness_Policy').output.firstRow.SourceSchema",
													"type": "Expression"
												},
												"TableName": {
													"value": "@activity('Lookup_Freshness_Policy').output.firstRow.SourceObject",
													"type": "Expression"
												}
											}
										},
										"firstRowOnly": true
									}
								},
								{
									"name": "Evaluate_SQL_Freshness",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "Lookup_SQL_Source_Latest_Time",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat('EXEC control.usp_CheckSourceFreshness @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @WindowKey=''',pipeline().parameters.WindowKey,''', @SourceLastModified=',if(empty(activity('Lookup_SQL_Source_Latest_Time').output.firstRow.ActualLatestTime),'NULL',concat('''',activity('Lookup_SQL_Source_Latest_Time').output.firstRow.ActualLatestTime,'''')))",
												"type": "Expression"
											},
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_MD_Control",
											"type": "DatasetReference"
										},
										"firstRowOnly": true
									}
								}
							]
						},
						{
							"value": "REST_API",
							"activities": [
								{
									"name": "Evaluate_REST_Freshness_Unknown",
									"description": "Generic REST freshness defaults to UNKNOWN unless an API-specific freshness probe is configured upstream; policy decides fail-open/fail-closed.",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat('EXEC control.usp_CheckSourceFreshness @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @WindowKey=''',pipeline().parameters.WindowKey,''', @SourceLastModified=NULL')",
												"type": "Expression"
											},
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_MD_Control",
											"type": "DatasetReference"
										},
										"firstRowOnly": true
									}
								}
							]
						},
						{
							"value": "__SKIP__",
							"activities": [
								{
									"name": "Evaluate_Disabled_Freshness",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat('EXEC control.usp_CheckSourceFreshness @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,''', @PipelineRunId=''',pipeline().parameters.ParentRunId,''', @WindowKey=''',pipeline().parameters.WindowKey,''', @SourceLastModified=NULL')",
												"type": "Expression"
											},
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_MD_Control",
											"type": "DatasetReference"
										},
										"firstRowOnly": true
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Fail_Unsupported_Freshness_Source",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Unsupported SourceType for freshness evaluation.",
								"errorCode": "FRESHNESS_SOURCE_UNSUPPORTED"
							}
						}
					]
				}
			},
			{
				"name": "Lookup_Freshness_Result",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Switch_Freshness_SourceType",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT TOP 1 FreshnessStatus,Severity,LagMinutes,ConsecutiveStaleCount,ConsecutiveStaleBreached,PolicyAction,Detail FROM control.SourceFreshnessResult WHERE EntityName=''',pipeline().parameters.EntityName,''' AND BatchId=''',pipeline().parameters.BatchId,''' AND ISNULL(WindowKey,'''')=''',pipeline().parameters.WindowKey,''' ORDER BY FreshnessResultId DESC')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set_FreshnessStatus",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Freshness_Result",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_FreshnessStatus",
					"value": {
						"value": "@activity('Lookup_Freshness_Result').output.firstRow.FreshnessStatus",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Severity",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_FreshnessStatus",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_Severity",
					"value": {
						"value": "@activity('Lookup_Freshness_Result').output.firstRow.Severity",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_LagMinutes",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Severity",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_LagMinutes",
					"value": {
						"value": "@int(coalesce(activity('Lookup_Freshness_Result').output.firstRow.LagMinutes,0))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_StaleCount",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_LagMinutes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ConsecutiveStaleCount",
					"value": {
						"value": "@int(activity('Lookup_Freshness_Result').output.firstRow.ConsecutiveStaleCount)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_StreakBreached",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_StaleCount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ConsecutiveStaleBreached",
					"value": {
						"value": "@bool(activity('Lookup_Freshness_Result').output.firstRow.ConsecutiveStaleBreached)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_PolicyAction",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_StreakBreached",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_PolicyAction",
					"value": {
						"value": "@activity('Lookup_Freshness_Result').output.firstRow.PolicyAction",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Update_Run_Freshness_Metric",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Set_PolicyAction",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_UpdateRunMetrics",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"FreshnessStatus": {
							"value": {
								"value": "@variables('v_FreshnessStatus')",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set_Freshness_Decision",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Update_Run_Freshness_Metric",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_DecisionCode",
					"value": {
						"value": "@if(equals(variables('v_FreshnessStatus'),'DISABLED'),'DISABLED',if(equals(variables('v_FreshnessStatus'),'FRESH'),'FRESH_CONTINUE',if(equals(variables('v_FreshnessStatus'),'UNKNOWN'),concat('UNKNOWN_',variables('v_PolicyAction')),if(equals(variables('v_FreshnessStatus'),'STALE'),concat('STALE_',variables('v_Severity'),'_',variables('v_PolicyAction')),'UNKNOWN_FAIL'))))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Switch_Freshness_Decision",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Set_Freshness_Decision",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@variables('v_DecisionCode')",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "FRESH_CONTINUE",
							"activities": [
								{
									"name": "Log_FRESH",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "control.usp_RecordStage",
										"storedProcedureParameters": {
											"EntityName": {
												"value": {
													"value": "@pipeline().parameters.EntityName",
													"type": "Expression"
												},
												"type": "String"
											},
											"PipelineRunId": {
												"value": {
													"value": "@pipeline().parameters.ParentRunId",
													"type": "Expression"
												},
												"type": "String"
											},
											"BatchId": {
												"value": {
													"value": "@pipeline().parameters.BatchId",
													"type": "Expression"
												},
												"type": "String"
											},
											"WindowKey": {
												"value": {
													"value": "@pipeline().parameters.WindowKey",
													"type": "Expression"
												},
												"type": "String"
											},
											"StageName": {
												"value": "SOURCE_FRESHNESS",
												"type": "String"
											},
											"Status": {
												"value": "SUCCESS",
												"type": "String"
											},
											"Detail": {
												"value": {
													"value": "@concat('Status=',variables('v_FreshnessStatus'),'; Severity=',variables('v_Severity'),'; LagMinutes=',string(variables('v_LagMinutes')),'; ConsecutiveStaleCount=',string(variables('v_ConsecutiveStaleCount')),'; StreakBreached=',string(variables('v_ConsecutiveStaleBreached')),'; Action=','FAIL')",
													"type": "Expression"
												},
												"type": "Expression"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						},
						{
							"value": "STALE_NONE_CONTINUE",
							"activities": [
								{
									"name": "Log_STALE_Below_Warning",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "control.usp_RecordStage",
										"storedProcedureParameters": {
											"EntityName": {
												"value": {
													"value": "@pipeline().parameters.EntityName",
													"type": "Expression"
												},
												"type": "String"
											},
											"PipelineRunId": {
												"value": {
													"value": "@pipeline().parameters.ParentRunId",
													"type": "Expression"
												},
												"type": "String"
											},
											"BatchId": {
												"value": {
													"value": "@pipeline().parameters.BatchId",
													"type": "Expression"
												},
												"type": "String"
											},
											"WindowKey": {
												"value": {
													"value": "@pipeline().parameters.WindowKey",
													"type": "Expression"
												},
												"type": "String"
											},
											"StageName": {
												"value": "SOURCE_FRESHNESS",
												"type": "String"
											},
											"Status": {
												"value": "WARNING",
												"type": "String"
											},
											"Detail": {
												"value": {
													"value": "@concat('Status=',variables('v_FreshnessStatus'),'; Severity=',variables('v_Severity'),'; LagMinutes=',string(variables('v_LagMinutes')),'; ConsecutiveStaleCount=',string(variables('v_ConsecutiveStaleCount')),'; StreakBreached=',string(variables('v_ConsecutiveStaleBreached')),'; Action=','FAIL')",
													"type": "Expression"
												},
												"type": "Expression"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference"
									}
								}
							]
						},
						{
							"value": "STALE_WARNING_CONTINUE",
							"activities": [
								{
									"name": "Alert_STALE_WARNING",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_MD_Common_Alert_Handler",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"EntityName": {
												"value": "@pipeline().parameters.EntityName",
												"type": "Expression"
											},
											"BatchId": {
												"value": "@pipeline().parameters.BatchId",
												"type": "Expression"
											},
											"ParentRunId": {
												"value": "@pipeline().parameters.ParentRunId",
												"type": "Expression"
											},
											"WindowKey": {
												"value": "@pipeline().parameters.WindowKey",
												"type": "Expression"
											},
											"AlertType": "SOURCE_STALE_WARNING",
											"Severity": {
												"value": "@variables('v_Severity')",
												"type": "Expression"
											},
											"ActivityName": "SOURCE_FRESHNESS",
											"Message": {
												"value": "@concat('Source stale. LagMinutes=',string(variables('v_LagMinutes')),'; ConsecutiveStaleCount=',string(variables('v_ConsecutiveStaleCount')))",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Log_WARNING_Continue",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "Alert_STALE_WARNING",
											"dependencyConditions": [
												"Completed"
											]
										}
