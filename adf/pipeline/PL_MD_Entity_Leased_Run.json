{
	"name": "PL_MD_Entity_Leased_Run",
	"properties": {
		"activities": [
			{
				"name": "Start_Or_Resume_Run",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_StartOrResumeEntityRun @EntityName=''',pipeline().parameters.EntityName,''', @PipelineName=''',pipeline().Pipeline,''', @PipelineRunId=''',pipeline().RunId,''', @ParentRunId=''',pipeline().parameters.ParentRunId,''', @BatchId=''',pipeline().parameters.BatchId,''', @RunMode=''',pipeline().parameters.RunMode,''', @RecoveryMode=''',pipeline().parameters.RecoveryMode,''', @ResumeFromStage=',if(empty(pipeline().parameters.ResumeFromStage),'NULL',concat('''',pipeline().parameters.ResumeFromStage,'''')))",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "If_Run_Process",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Start_Or_Resume_Run",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Start_Or_Resume_Run').output.firstRow.RunDecision,'PROCESS')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Log_Already_Completed_Resume_Attempt",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_LogSkippedRun",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"ParentRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"RunMode": {
										"value": {
											"value": "@pipeline().parameters.RunMode",
											"type": "Expression"
										},
										"type": "String"
									},
									"ErrorCode": {
										"value": "BATCH_ALREADY_COMPLETED",
										"type": "String"
									},
									"ErrorMessage": {
										"value": "Logical BatchId already completed successfully; resume attempt skipped.",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Release_Lease_Already_Completed",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Log_Already_Completed_Resume_Attempt",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_ReleaseEntityLease",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Run_Window_Controller",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"RunMode": {
										"value": "@pipeline().parameters.RunMode",
										"type": "Expression"
									},
									"WindowStart": {
										"value": "@pipeline().parameters.WindowStart",
										"type": "Expression"
									},
									"WindowEnd": {
										"value": "@pipeline().parameters.WindowEnd",
										"type": "Expression"
									},
									"RecoveryMode": {
										"value": "@pipeline().parameters.RecoveryMode",
										"type": "Expression"
									},
									"ResumeFromStage": {
										"value": "@pipeline().parameters.ResumeFromStage",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"RunMode": {
				"type": "String",
				"defaultValue": "NORMAL"
			},
			"WindowStart": {
				"type": "String"
			},
			"WindowEnd": {
				"type": "String"
			},
			"RecoveryMode": {
				"type": "String",
				"defaultValue": "AUTO"
			},
			"ResumeFromStage": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": []
	}
}