{
	"name": "PL_EIA_to_ADLS_then_SQL_Staging",
	"properties": {
		"description": "Fetches recent WTI oil prices from EIA REST API ONCE (date-bounded, single page — no automatic pagination), lands to ADLS Bronze under capped exponential backoff, then loads staging.OilPrice from the landed Bronze file.",
		"activities": [
			{
				"name": "Init_RetryCount",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_RetryCount",
					"value": 0
				}
			},
			{
				"name": "Init_DelaySeconds",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_DelaySeconds",
					"value": 30
				}
			},
			{
				"name": "Init_APISuccess",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_APISuccess",
					"value": false
				}
			},
			{
				"name": "Init_BronzeFolderPath",
				"description": "Fix path ONCE so retries and SQL load point at the same landed file.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_BronzeFolderPath",
					"value": {
						"value": "@concat('bronze/oilprice/', formatDateTime(utcnow(),'yyyy-MM-dd'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Init_BronzeFileName",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_BronzeFileName",
					"value": {
						"value": "@concat('OilPrice_', formatDateTime(utcnow(),'yyyy-MM-dd'), '.parquet')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Init_StartDate",
				"description": "Lookback window start. 7 days of daily WTI data = well under 5000 rows, so a single request always covers it — no pagination required.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_StartDate",
					"value": {
						"value": "@formatDateTime(addDays(utcnow(), mul(pipeline().parameters.EIA_LookbackDays, -1)), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Init_EndDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_EndDate",
					"value": {
						"value": "@formatDateTime(utcnow(), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "GetEIAKey",
				"description": "Fetch EIA API key from Key Vault. Built-in retry only.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Init_RetryCount",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_DelaySeconds",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_APISuccess",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_BronzeFolderPath",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_BronzeFileName",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_StartDate",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_EndDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:01:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://aer-oilgas-kv.vault.azure.net/secrets/eia-api-key?api-version=7.0')",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Until_EIAAPI_Success",
				"description": "The ONLY call to the EIA API. Date-bounded (start/end) so it always fits in one page — no paginationRules needed, so the ADF bracket-param pagination bug can't trigger. Capped exponential backoff on transient failure.",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "GetEIAKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(variables('v_APISuccess'), true), greaterOrEquals(variables('v_RetryCount'), 5))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy EIA Data to Adls",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"additionalColumns": [
										{
											"name": "IngestionDate",
											"value": {
												"value": "@utcnow()",
												"type": "Expression"
											}
										}
									],
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "['period']"
											},
											"sink": {
												"name": "period",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['value']"
											},
											"sink": {
												"name": "value",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['series-description']"
											},
											"sink": {
												"name": "series-description",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['product-name']"
											},
											"sink": {
												"name": "product-name",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['units']"
											},
											"sink": {
												"name": "units",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['response']['IngestionDate']"
											},
											"sink": {
												"name": "IngestionDate",
												"type": "DateTime"
											}
										}
									],
									"collectionReference": "$['response']['data']"
								}
							},
							"inputs": [
								{
									"referenceName": "DS_EIA_REST_Source",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": "@concat('v2/petroleum/pri/spt/data/?api_key=', activity('GetEIAKey').output.value, '&frequency=daily&data[0]=value&facets[series][]=RWTC&sort[0][column]=period&sort[0][direction]=desc&start=', variables('v_StartDate'), '&end=', variables('v_EndDate'), '&length=', string(pipeline().parameters.EIA_PageSize))"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_OilPrice",
									"type": "DatasetReference",
									"parameters": {
										"FolderPath": {
											"value": "@variables('v_BronzeFolderPath')",
											"type": "Expression"
										},
										"FileName": {
											"value": "@variables('v_BronzeFileName')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Set_APISuccess_True",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy EIA Data to Adls",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_APISuccess",
								"value": true
							}
						},
						{
							"name": "Wait_CurrentDelay",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Copy EIA Data to Adls",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('v_DelaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Compute_NextRetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_CurrentDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextRetryCount",
								"value": {
									"value": "@add(variables('v_RetryCount'), 1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Compute_NextDelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_CurrentDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextDelaySeconds",
								"value": {
									"value": "@if(greater(mul(variables('v_DelaySeconds'),2), variables('v_MaxDelaySeconds')), variables('v_MaxDelaySeconds'), mul(variables('v_DelaySeconds'),2))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextRetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextRetryCount",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_RetryCount",
								"value": {
									"value": "@variables('v_NextRetryCount')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextDelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextDelaySeconds",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_DelaySeconds",
								"value": {
									"value": "@variables('v_NextDelaySeconds')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.01:00:00"
				}
			},
			{
				"name": "Check_EIAAPI_Result",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until_EIAAPI_Success",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_APISuccess'), false)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Fail_EIAUnavailable",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "EIA API did not succeed after 5 retries with capped exponential backoff.",
								"errorCode": "EIA_API_UNAVAILABLE"
							}
						}
					]
				}
			},
			{
				"name": "Copy Bronze to SQL",
				"description": "Reads the landed Bronze parquet — does NOT call EIA again.",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check_EIAAPI_Result",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "TRUNCATE TABLE staging.OilPrice",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "period",
									"type": "String"
								},
								"sink": {
									"name": "period",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "value",
									"type": "String"
								},
								"sink": {
									"name": "value",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "series-description",
									"type": "String"
								},
								"sink": {
									"name": "series-description",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "product-name",
									"type": "String"
								},
								"sink": {
									"name": "product-name",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "units",
									"type": "String"
								},
								"sink": {
									"name": "units",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "IngestionDate",
									"type": "DateTime"
								},
								"sink": {
									"name": "IngestionDate"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Bronze_OilPrice",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "@variables('v_BronzeFolderPath')",
								"type": "Expression"
							},
							"FileName": {
								"value": "@variables('v_BronzeFileName')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_AzureSQL_OilPrice_Sink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"EIA_LookbackDays": {
				"type": "int",
				"defaultValue": 7
			},
			"EIA_PageSize": {
				"type": "int",
				"defaultValue": 5000
			}
		},
		"variables": {
			"v_RetryCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_NextRetryCount": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_DelaySeconds": {
				"type": "Integer",
				"defaultValue": 30
			},
			"v_NextDelaySeconds": {
				"type": "Integer",
				"defaultValue": 30
			},
			"v_MaxDelaySeconds": {
				"type": "Integer",
				"defaultValue": 480
			},
			"v_APISuccess": {
				"type": "Boolean",
				"defaultValue": false
			},
			"v_BronzeFolderPath": {
				"type": "String"
			},
			"v_BronzeFileName": {
				"type": "String"
			},
			"v_StartDate": {
				"type": "String"
			},
			"v_EndDate": {
				"type": "String"
			}
		},
		"annotations": [
			"EIA",
			"WTI",
			"OilPrice",
			"REST",
			"KeyVault",
			"ExponentialBackoff",
			"SingleAPICall",
			"CappedDelay",
			"DateBounded"
		],
		"lastPublishTime": "2026-04-19T21:18:16Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}