{
	"name": "PL_MD_REST_Ingestion",
	"properties": {
		"description": "Generic REST adapter. PAGE_NUMBER/NEXT_LINK control requests use error-aware bounded exponential backoff with jitter. NONE uses direct REST Copy; endpoint-specific auth and response persistence remain entity/source profile concerns.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Switch_Pagination",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@coalesce(activity('Lookup_Config').output.firstRow.PaginationType,'NONE')",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "NONE",
							"activities": [
								{
									"name": "Copy_REST_To_Bronze",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_MD_REST_Copy_With_Retry",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"EntityName": {
												"value": "@pipeline().parameters.EntityName",
												"type": "Expression"
											},
											"BatchId": {
												"value": "@pipeline().parameters.BatchId",
												"type": "Expression"
											},
											"ParentRunId": {
												"value": "@pipeline().parameters.ParentRunId",
												"type": "Expression"
											},
											"WindowKey": {
												"value": "@pipeline().parameters.WindowKey",
												"type": "Expression"
											}
										}
									}
								}
							]
						},
						{
							"value": "PAGE_NUMBER"
						},
						{
							"value": "NEXT_LINK",
							"activities": [
								{
									"name": "Set_Initial_URL",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_NextUrl",
										"value": {
											"value": "@concat(activity('Lookup_Config').output.firstRow.ApiBaseUrl,activity('Lookup_Config').output.firstRow.ApiRelativeUrl)",
											"type": "Expression"
										}
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Fail_Unsupported_Pagination",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Unsupported REST pagination type",
								"errorCode": "UNSUPPORTED_PAGINATION"
							}
						}
					]
				}
			},
			{
				"name": "Until_Pages_Done",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Switch_Pagination",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(not(equals(coalesce(activity('Lookup_Config').output.firstRow.PaginationType,'NONE'),'PAGE_NUMBER')),equals(variables('v_HasMore'),false))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Get_Page",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"Url": {
										"value": "@concat(activity('Lookup_Config').output.firstRow.ApiBaseUrl,activity('Lookup_Config').output.firstRow.ApiRelativeUrl,'?',activity('Lookup_Config').output.firstRow.PageNumberParameter,'=',string(variables('v_Page')),'&',activity('Lookup_Config').output.firstRow.PageSizeParameter,'=',string(activity('Lookup_Config').output.firstRow.PageSize))",
										"type": "Expression"
									},
									"ActivityName": "Get_Page"
								}
							}
						},
						{
							"name": "Set_HasMore",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Get_Page",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_HasMore",
								"value": {
									"value": "@greater(length(json(activity('Get_Page').output.pipelineReturnValue.ResponseJson)[activity('Lookup_Config').output.firstRow.ItemsPropertyName]),0)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Calc_Next_Page",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_HasMore",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextPage",
								"value": {
									"value": "@add(variables('v_Page'),1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Increment_Page",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Calc_Next_Page",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Page",
								"value": {
									"value": "@variables('v_NextPage')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "Until_NextLink_Empty",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Switch_Pagination",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(not(equals(coalesce(activity('Lookup_Config').output.firstRow.PaginationType,'NONE'),'NEXT_LINK')),empty(variables('v_NextUrl')))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Get_Next_Page",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@pipeline().parameters.WindowKey",
										"type": "Expression"
									},
									"Url": {
										"value": "@variables('v_NextUrl')",
										"type": "Expression"
									},
									"ActivityName": "Get_Next_Page"
								}
							}
						},
						{
							"name": "Set_NextUrl",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Get_Next_Page",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextUrl",
								"value": {
									"value": "@string(json(activity('Get_Next_Page').output.pipelineReturnValue.ResponseJson)[activity('Lookup_Config').output.firstRow.NextLinkPropertyName])",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"ExtractionStart": {
				"type": "String"
			},
			"EndWatermark": {
				"type": "String"
			}
		},
		"variables": {
			"v_Page": {
				"type": "Integer",
				"defaultValue": 1
			},
			"v_HasMore": {
				"type": "Boolean",
				"defaultValue": true
			},
			"v_NextUrl": {
				"type": "String"
			},
			"v_NextPage": {
				"type": "Integer",
				"defaultValue": 2
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"REST_ADAPTER",
			"EXPONENTIAL_BACKOFF"
		]
	}
}