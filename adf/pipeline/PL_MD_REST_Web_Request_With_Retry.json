{
	"name": "PL_MD_REST_Web_Request_With_Retry",
	"properties": {
		"description": "Reusable REST Web request with error classification, bounded exponential backoff and jitter. Returns response JSON to the caller.",
		"activities": [
			{
				"name": "Lookup_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_GetEntityConfig @EntityName=''',pipeline().parameters.EntityName,'''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Until_Request_Done",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Lookup_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_Done'),true)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Web_Request",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@pipeline().parameters.Url",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_Response",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Web_Request",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Response",
								"value": {
									"value": "@string(activity('Web_Request').output)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Mark_Request_Done",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_Response",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Done",
								"value": true
							}
						},
						{
							"name": "Capture_REST_ErrorCode",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Web_Request",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ErrorCode",
								"value": {
									"value": "@activity('Web_Request').error.code",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Capture_REST_ErrorMessage",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Web_Request",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ErrorMessage",
								"value": {
									"value": "@activity('Web_Request').error.message",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Retry_Decision_V4",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Capture_REST_ErrorCode",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Capture_REST_ErrorMessage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC control.usp_GetRetryDecisionV4 @PolicyName=''',activity('Lookup_Config').output.firstRow.RetryPolicyName,''', @ErrorCode=''',replace(variables('v_ErrorCode'),'''',''''''),''', @ErrorMessage=N''',replace(variables('v_ErrorMessage'),'''',''''''),''', @RetryAttempt=',string(variables('v_Attempt')))",
										"type": "Expression"
									},
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_MD_Control",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "Set_REST_Decision",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Retry_Decision_V4",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Decision",
								"value": {
									"value": "@activity('Retry_Decision_V4').output.firstRow.RetryDecision",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_REST_Wait",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Retry_Decision_V4",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_WaitSeconds",
								"value": {
									"value": "@int(activity('Retry_Decision_V4').output.firstRow.ComputedWaitSeconds)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Record_REST_Retry",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Set_REST_Decision",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set_REST_Wait",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_RecordRetry",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().parameters.ParentRunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"WindowKey": {
										"value": {
											"value": "@pipeline().parameters.WindowKey",
											"type": "Expression"
										},
										"type": "String"
									},
									"ActivityName": {
										"value": {
											"value": "@pipeline().parameters.ActivityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"RetryAttempt": {
										"value": {
											"value": "@variables('v_Attempt')",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"ErrorCode": {
										"value": {
											"value": "@variables('v_ErrorCode')",
											"type": "Expression"
										},
										"type": "String"
									},
									"ErrorMessage": {
										"value": {
											"value": "@variables('v_ErrorMessage')",
											"type": "Expression"
										},
										"type": "String"
									},
									"ErrorCategory": {
										"value": {
											"value": "@activity('Retry_Decision_V4').output.firstRow.ErrorCategory",
											"type": "Expression"
										},
										"type": "String"
									},
									"Decision": {
										"value": {
											"value": "@variables('v_Decision')",
											"type": "Expression"
										},
										"type": "String"
									},
									"WaitSeconds": {
										"value": {
											"value": "@variables('v_WaitSeconds')",
											"type": "Expression"
										},
										"type": "Int32"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Snapshot_Current_Attempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Record_REST_Retry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_CurrentAttemptSnapshot",
								"value": {
									"value": "@variables('v_Attempt')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Calc_Next_Attempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Snapshot_Current_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextAttempt",
								"value": {
									"value": "@add(variables('v_Attempt'),1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_Next_Attempt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Calc_Next_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Attempt",
								"value": {
									"value": "@if(equals(variables('v_Decision'),'RETRY'),variables('v_NextAttempt'),variables('v_CurrentAttemptSnapshot'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Wait_If_Retry",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Apply_Next_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@if(equals(variables('v_Decision'),'RETRY'),variables('v_WaitSeconds'),0)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Stop_Loop_If_Final",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_If_Retry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_Done",
								"value": {
									"value": "@not(equals(variables('v_Decision'),'RETRY'))",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "Return_REST_Response",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Until_Request_Done",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "ResponseJson",
							"value": {
								"type": "Expression",
								"content": "@variables('v_Response')"
							}
						}
					],
					"setSystemVariable": true
				}
			},
			{
				"name": "If_Final_Retry_Failure",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until_Request_Done",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(equals(variables('v_Done'),true),not(empty(variables('v_Decision'))),not(equals(variables('v_Decision'),'RETRY')))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Fail_REST_Request",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@variables('v_ErrorMessage')",
									"type": "Expression"
								},
								"errorCode": {
									"value": "@variables('v_ErrorCode')",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"Url": {
				"type": "String"
			},
			"ActivityName": {
				"type": "String"
			}
		},
		"variables": {
			"v_Done": {
				"type": "Boolean",
				"defaultValue": false
			},
			"v_Attempt": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_ErrorCode": {
				"type": "String"
			},
			"v_ErrorMessage": {
				"type": "String"
			},
			"v_Decision": {
				"type": "String"
			},
			"v_WaitSeconds": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_Response": {
				"type": "String",
				"defaultValue": "{}"
			},
			"v_NextAttempt": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_CurrentAttemptSnapshot": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"REST_ADAPTER",
			"EXPONENTIAL_BACKOFF",
			"ERROR_AWARE_RETRY"
		]
	}
}