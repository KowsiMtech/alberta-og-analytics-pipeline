{
	"name": "PL_EIA_IncrementalIngestion",
	"properties": {
		"description": "Fetches WTI oil prices from EIA REST API using watermark-driven incremental loading, first-run lookback, manual pagination, retry/backoff, late-arriving-data handling, and pipeline return values for downstream Gold processing.",
		"activities": [
			{
				"name": "Lookup_Watermark",
				"description": "Read last successful source date from control.PipelineWatermark.",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT LastSuccessfulLoadDate FROM control.PipelineWatermark WHERE PipelineName = ''', pipeline().Pipeline, '''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Generic",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set_StartDate",
				"description": "Use watermark + 1 day when available, first-run lookback otherwise, and clamp StartDate to TriggerDate to avoid StartDate > EndDate on same-day reruns.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_StartDate",
					"value": {
						"value": "@if(equals(length(activity('Lookup_Watermark').output.value), 0), formatDateTime(addDays(pipeline().TriggerTime, mul(pipeline().parameters.EIA_DefaultLookbackDays, -1)), 'yyyy-MM-dd'), if(greater(formatDateTime(addDays(activity('Lookup_Watermark').output.value[0].LastSuccessfulLoadDate, 1), 'yyyy-MM-dd'), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd')), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), formatDateTime(addDays(activity('Lookup_Watermark').output.value[0].LastSuccessfulLoadDate, 1), 'yyyy-MM-dd')))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_EndDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_EndDate",
					"value": {
						"value": "@formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_BronzeFolderPath",
				"description": "Create deterministic Bronze folder using extraction start/end dates.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_StartDate",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_EndDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_BronzeFolderPath",
					"value": {
						"value": "@concat('bronze/oilprice/start_date=', variables('v_StartDate'), '/end_date=', variables('v_EndDate'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Init_PageOffset",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_PageOffset",
					"value": 0
				}
			},
			{
				"name": "Init_RetryCount",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_RetryCount",
					"value": 0
				}
			},
			{
				"name": "Init_DelaySeconds",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_DelaySeconds",
					"value": 30
				}
			},
			{
				"name": "Get_EIAKey",
				"description": "Fetch EIA API key from Key Vault.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Init_PageOffset",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_RetryCount",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_DelaySeconds",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_BronzeFolderPath",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:01:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://aer-oilgas-kv.vault.azure.net/secrets/eia-api-key?api-version=7.0')",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Get_EIATotal",
				"description": "Probe EIA API to obtain total rows for extraction window.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get_EIAKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:01:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://api.eia.gov/v2/petroleum/pri/spt/data/?api_key=', activity('Get_EIAKey').output.value, '&frequency=daily&data[0]=value&facets[series][]=RWTC&start=', variables('v_StartDate'), '&end=', variables('v_EndDate'), '&offset=0&length=1')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_ResponseTotal",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get_EIATotal",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ResponseTotal",
					"value": {
						"value": "@int(activity('Get_EIATotal').output.response.total)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Until_AllPagesFetched",
				"description": "Manual offset pagination with retry handling.",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Set_ResponseTotal",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(greaterOrEquals(variables('v_PageOffset'), variables('v_ResponseTotal')), greaterOrEquals(variables('v_RetryCount'), 5))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_EIAPage_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"additionalColumns": [
										{
											"name": "IngestionDate",
											"value": {
												"value": "@pipeline().TriggerTime",
												"type": "Expression"
											}
										},
										{
											"name": "PipelineRunId",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										},
										{
											"name": "SourceStartDate",
											"value": {
												"value": "@variables('v_StartDate')",
												"type": "Expression"
											}
										},
										{
											"name": "SourceEndDate",
											"value": {
												"value": "@variables('v_EndDate')",
												"type": "Expression"
											}
										}
									],
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "['period']"
											},
											"sink": {
												"name": "period",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['value']"
											},
											"sink": {
												"name": "value",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['series-description']"
											},
											"sink": {
												"name": "series-description",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['product-name']"
											},
											"sink": {
												"name": "product-name",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['units']"
											},
											"sink": {
												"name": "units",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['IngestionDate']"
											},
											"sink": {
												"name": "IngestionDate",
												"type": "DateTime"
											}
										},
										{
											"source": {
												"path": "$['PipelineRunId']"
											},
											"sink": {
												"name": "PipelineRunId",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['SourceStartDate']"
											},
											"sink": {
												"name": "SourceStartDate",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['SourceEndDate']"
											},
											"sink": {
												"name": "SourceEndDate",
												"type": "String"
											}
										}
									],
									"collectionReference": "$['response']['data']"
								}
							},
							"inputs": [
								{
									"referenceName": "DS_EIA_REST_Source",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": "@concat('v2/petroleum/pri/spt/data/?api_key=', activity('Get_EIAKey').output.value, '&frequency=daily&data[0]=value&facets[series][]=RWTC&sort[0][column]=period&sort[0][direction]=desc&start=', variables('v_StartDate'), '&end=', variables('v_EndDate'), '&offset=', string(variables('v_PageOffset')), '&length=', string(pipeline().parameters.EIA_PageSize))"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_OilPrice",
									"type": "DatasetReference",
									"parameters": {
										"FolderPath": {
											"value": "@variables('v_BronzeFolderPath')",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat('OilPrice_p', string(variables('v_PageOffset')), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Compute_NextPageOffset",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy_EIAPage_To_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextPageOffset",
								"value": {
									"value": "@add(variables('v_PageOffset'), pipeline().parameters.EIA_PageSize)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextPageOffset",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextPageOffset",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_PageOffset",
								"value": {
									"value": "@variables('v_NextPageOffset')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Reset_RetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Apply_NextPageOffset",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_RetryCount",
								"value": 0
							}
						},
						{
							"name": "Reset_DelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Apply_NextPageOffset",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_DelaySeconds",
								"value": 30
							}
						},
						{
							"name": "Wait_CurrentDelay",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Copy_EIAPage_To_Bronze",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('v_DelaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Compute_NextRetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_CurrentDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextRetryCount",
								"value": {
									"value": "@add(variables('v_RetryCount'), 1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Compute_NextDelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_CurrentDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextDelaySeconds",
								"value": {
									"value": "@if(greater(mul(variables('v_DelaySeconds'),2), variables('v_MaxDelaySeconds')), variables('v_MaxDelaySeconds'), mul(variables('v_DelaySeconds'),2))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextRetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextRetryCount",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_RetryCount",
								"value": {
									"value": "@variables('v_NextRetryCount')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextDelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextDelaySeconds",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_DelaySeconds",
								"value": {
									"value": "@variables('v_NextDelaySeconds')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.02:00:00"
				}
			},
			{
				"name": "Check_PaginationResult",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until_AllPagesFetched",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@less(variables('v_PageOffset'), variables('v_ResponseTotal'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Fail_PaginationIncomplete",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "EIA pagination did not complete after retries exhausted on one page.",
								"errorCode": "EIA_PAGINATION_RETRY_EXHAUSTED"
							}
						}
					]
				}
			},
			{
				"name": "Copy_Bronze_To_SQL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check_PaginationResult",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFileName": "*.parquet"
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "TRUNCATE TABLE staging.OilPrice",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "period",
									"type": "String"
								},
								"sink": {
									"name": "period",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "value",
									"type": "String"
								},
								"sink": {
									"name": "value",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "series-description",
									"type": "String"
								},
								"sink": {
									"name": "series-description",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "product-name",
									"type": "String"
								},
								"sink": {
									"name": "product-name",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "units",
									"type": "String"
								},
								"sink": {
									"name": "units",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "IngestionDate",
									"type": "DateTime"
								},
								"sink": {
									"name": "IngestionDate"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Bronze_OilPrice",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "@variables('v_BronzeFolderPath')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_AzureSQL_OilPrice_Sink",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Check_DataAvailability",
				"description": "Update watermark only if EIA actually returned rows.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Copy_Bronze_To_SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(variables('v_ResponseTotal'), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update_Watermark",
							"description": "Advance watermark only when data was returned and loaded successfully.",
							"type": "Script",
