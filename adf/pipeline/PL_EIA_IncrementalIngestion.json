{
	"name": "PL_EIA_IncrementalIngestion",
	"properties": {
		"description": "Fetches WTI oil prices from EIA REST API since the last successful load (watermark-driven date range), with proper manual offset pagination, capped exponential backoff per page, and late-arriving-data handling (watermark only advances when rows were actually returned). Lands to ADLS Bronze, loads staging.OilPrice from Bronze, then conditionally advances the watermark. Exposes the extraction window as a pipeline return value for downstream Gold processing.",
		"activities": [
			{
				"name": "Lookup_Watermark",
				"description": "Read the last successfully processed source date for the current pipeline from control.PipelineWatermark.",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT LastSuccessfulLoadDate FROM control.PipelineWatermark WHERE PipelineName = ''', pipeline().Pipeline, '''')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Generic",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Init_PageOffset",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_PageOffset",
					"value": 0
				}
			},
			{
				"name": "Init_RetryCount",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_RetryCount",
					"value": 0
				}
			},
			{
				"name": "Init_DelaySeconds",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_DelaySeconds",
					"value": 30
				}
			},
			{
				"name": "Set_BronzeFolderPath",
				"description": "Deterministic Bronze path based on the extraction window so rerunning the same watermark window targets the same logical Bronze location.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_StartDate",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_EndDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_BronzeFolderPath",
					"value": {
						"value": "@concat('bronze/oilprice/start_date=', variables('v_StartDate'), '/end_date=', variables('v_EndDate'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_StartDate",
				"description": "Start from the day after LastSuccessfulLoadDate. Falls back to EIA_DefaultLookbackDays if the watermark row is missing (first-ever run, or table was reset) — self-healing rather than crashing.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_StartDate",
					"value": {
						"value": "@if(equals(length(activity('Lookup_Watermark').output.value), 0), formatDateTime(addDays(pipeline().TriggerTime, mul(pipeline().parameters.EIA_DefaultLookbackDays, -1)),'yyyy-MM-dd'), formatDateTime(addDays(activity('Lookup_Watermark').output.value[0].LastSuccessfulLoadDate, 1),'yyyy-MM-dd'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_EndDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_EndDate",
					"value": {
						"value": "@formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get_EIAKey",
				"description": "Fetch EIA API key from Key Vault. Built-in retry only.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Init_PageOffset",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_RetryCount",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Init_DelaySeconds",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_BronzeFolderPath",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:01:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://aer-oilgas-kv.vault.azure.net/secrets/eia-api-key?api-version=7.0')",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Get_EIATotal",
				"description": "Cheap probe call (length=1) purely to read response.total for this date range. WebActivity captures the JSON body, which Copy activity cannot.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get_EIAKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:01:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://api.eia.gov/v2/petroleum/pri/spt/data/?api_key=', activity('Get_EIAKey').output.value, '&frequency=daily&data[0]=value&facets[series][]=RWTC&start=', variables('v_StartDate'), '&end=', variables('v_EndDate'), '&offset=0&length=1')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_ResponseTotal",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get_EIATotal",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ResponseTotal",
					"value": {
						"value": "@int(activity('Get_EIATotal').output.response.total)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Until_AllPagesFetched",
				"description": "Manual offset pagination. Loops until v_PageOffset covers v_ResponseTotal, or retries are exhausted. If v_ResponseTotal is 0 (no data yet for this window — late arrival), the loop exits immediately with success and zero pages copied.",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Set_ResponseTotal",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(greaterOrEquals(variables('v_PageOffset'), variables('v_ResponseTotal')), greaterOrEquals(variables('v_RetryCount'), 5))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_EIAPage_To_Bronze",
							"description": "Copies one EIA page to a deterministic page file in the extraction-window Bronze folder; the offset advances only after success.",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"additionalColumns": [
										{
											"name": "IngestionDate",
											"value": {
												"value": "@pipeline().TriggerTime",
												"type": "Expression"
											}
										},
										{
											"name": "PipelineRunId",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										},
										{
											"name": "SourceStartDate",
											"value": {
												"value": "@variables('v_StartDate')",
												"type": "Expression"
											}
										},
										{
											"name": "SourceEndDate",
											"value": {
												"value": "@variables('v_EndDate')",
												"type": "Expression"
											}
										}
									],
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "['period']"
											},
											"sink": {
												"name": "period",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['value']"
											},
											"sink": {
												"name": "value",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['series-description']"
											},
											"sink": {
												"name": "series-description",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['product-name']"
											},
											"sink": {
												"name": "product-name",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "['units']"
											},
											"sink": {
												"name": "units",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['IngestionDate']"
											},
											"sink": {
												"name": "IngestionDate",
												"type": "DateTime"
											}
										},
										{
											"source": {
												"path": "$['PipelineRunId']"
											},
											"sink": {
												"name": "PipelineRunId",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['SourceStartDate']"
											},
											"sink": {
												"name": "SourceStartDate",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['SourceEndDate']"
											},
											"sink": {
												"name": "SourceEndDate",
												"type": "String"
											}
										}
									],
									"collectionReference": "$['response']['data']"
								}
							},
							"inputs": [
								{
									"referenceName": "DS_EIA_REST_Source",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": "@concat('v2/petroleum/pri/spt/data/?api_key=', activity('Get_EIAKey').output.value, '&frequency=daily&data[0]=value&facets[series][]=RWTC&sort[0][column]=period&sort[0][direction]=desc&start=', variables('v_StartDate'), '&end=', variables('v_EndDate'), '&offset=', string(variables('v_PageOffset')), '&length=', string(pipeline().parameters.EIA_PageSize))"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_OilPrice",
									"type": "DatasetReference",
									"parameters": {
										"FolderPath": {
											"value": "@variables('v_BronzeFolderPath')",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat('OilPrice_p', string(variables('v_PageOffset')), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Compute_NextPageOffset",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy_EIAPage_To_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextPageOffset",
								"value": {
									"value": "@add(variables('v_PageOffset'), pipeline().parameters.EIA_PageSize)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextPageOffset",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextPageOffset",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_PageOffset",
								"value": {
									"value": "@variables('v_NextPageOffset')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Reset_RetryCount",
							"description": "Backoff resets per page — a slow page shouldn't inflate the delay for the next page's first attempt.",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Apply_NextPageOffset",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_RetryCount",
								"value": 0
							}
						},
						{
							"name": "Reset_DelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Apply_NextPageOffset",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_DelaySeconds",
								"value": 30
							}
						},
						{
							"name": "Wait_CurrentDelay",
							"description": "Same page retried after capped exponential wait.",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "Copy_EIAPage_To_Bronze",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@variables('v_DelaySeconds')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Compute_NextRetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_CurrentDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextRetryCount",
								"value": {
									"value": "@add(variables('v_RetryCount'), 1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Compute_NextDelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Wait_CurrentDelay",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_NextDelaySeconds",
								"value": {
									"value": "@if(greater(mul(variables('v_DelaySeconds'),2), variables('v_MaxDelaySeconds')), variables('v_MaxDelaySeconds'), mul(variables('v_DelaySeconds'),2))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextRetryCount",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextRetryCount",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_RetryCount",
								"value": {
									"value": "@variables('v_NextRetryCount')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Apply_NextDelaySeconds",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Compute_NextDelaySeconds",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_DelaySeconds",
								"value": {
									"value": "@variables('v_NextDelaySeconds')",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.02:00:00"
				}
			},
			{
				"name": "Check_PaginationResult",
				"description": "If the loop exited because retries were exhausted (not because pagination completed), fail explicitly rather than loading a partial Bronze folder.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until_AllPagesFetched",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@less(variables('v_PageOffset'), variables('v_ResponseTotal'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Fail_PaginationIncomplete",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "EIA pagination did not complete after retries exhausted on one page.",
								"errorCode": "EIA_PAGINATION_RETRY_EXHAUSTED"
							}
						}
					]
				}
			},
			{
				"name": "Copy_Bronze_To_SQL",
				"description": "Reads the ENTIRE day's Bronze folder (all page files, recursive, via wildcard) — does NOT call EIA again. Runs even if zero rows exist (writes/truncates an empty result), which is fine since the watermark won't advance in that case.",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check_PaginationResult",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFileName": "*.parquet"
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "TRUNCATE TABLE staging.OilPrice",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "period",
									"type": "String"
								},
								"sink": {
									"name": "period",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "value",
									"type": "String"
								},
								"sink": {
									"name": "value",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "series-description",
									"type": "String"
								},
								"sink": {
									"name": "series-description",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "product-name",
									"type": "String"
								},
								"sink": {
									"name": "product-name",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "units",
									"type": "String"
								},
								"sink": {
									"name": "units",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "IngestionDate",
									"type": "DateTime"
								},
								"sink": {
									"name": "IngestionDate"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Bronze_OilPrice",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "@variables('v_BronzeFolderPath')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_AzureSQL_OilPrice_Sink",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Check_DataAvailability",
				"description": "Only advance the watermark if EIA actually returned rows for this window (v_ResponseTotal > 0). If total was 0 — source data not yet published for this date range — the watermark is left untouched, so the next scheduled run retries the exact same window automatically. This is how late-arriving source data is handled: no fixed lookback buffer, no manual backfill required.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Copy_Bronze_To_SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(variables('v_ResponseTotal'), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update_Watermark",
							"description": "Advance watermark ONLY after SQL load succeeds AND rows were actually present. A failed run, or a run with zero rows for a late-arriving date, never advances it.",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n'MERGE control.PipelineWatermark AS target\nUSING (SELECT ''',\npipeline().Pipeline,\n''' AS PipelineName) AS src\nON target.PipelineName = src.PipelineName\n\nWHEN MATCHED THEN\nUPDATE SET\n    LastSuccessfulLoadDate = ''',\nvariables('v_EndDate'),\n''',\n    LastSuccessfulRunTime = SYSUTCDATETIME(),\n    LastSuccessfulRunId = ''',\npipeline().RunId,\n''',\n    LastUpdatedTime = SYSUTCDATETIME()\n\nWHEN NOT MATCHED THEN\nINSERT (\n    PipelineName,\n    LastSuccessfulLoadDate,\n    LastSuccessfulRunTime,\n    LastSuccessfulRunId,\n    LastUpdatedTime\n)\nVALUES (\n    ''',\npipeline().Pipeline,\n''',\n    ''',\nvariables('v_EndDate'),\n''',\n    SYSUTCDATETIME(),\n    ''',\npipeline().RunId,\n''',\n    SYSUTCDATETIME()\n);'\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Set_PipelineReturnValue",
				"description": "Exposes v_StartDate/v_EndDate as pipeline return value so the master orchestrator can pass the same watermark window to PL_Bronze_OilPrice_to_Gold. Runs regardless of which Check_DataAvailability branch executed, so downstream consumers always know the extraction window — even if it was a late-arriving-data no-op.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check_DataAvailability",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
