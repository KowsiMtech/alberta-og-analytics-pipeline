			},
			{
				"name": "Set_ExtractionStart",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_EndWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_ExtractionStart",
					"value": {
						"value": "@string(activity('Resolve_Window').output.firstRow.ExtractionStart)",
						"type": "Expression"
