			"v_StartWatermark": {
				"type": "String"
			},
			"v_EndWatermark": {
				"type": "String"
			},
			"v_ExtractionStart": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": []
	}
}