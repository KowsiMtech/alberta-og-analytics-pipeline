				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Check_Window_Idempotency').output.firstRow.WindowDecision,'PROCESS')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Close_Window_Already_Succeeded",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_EndEntityRun",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"BatchId": {
										"value": {
											"value": "@pipeline().parameters.BatchId",
											"type": "Expression"
										},
										"type": "String"
									},
									"Status": {
										"value": "SKIPPED",
										"type": "String"
									},
									"DataLoadStatus": {
										"value": "SKIPPED",
										"type": "String"
									},
									"ErrorCode": {
										"value": "WINDOW_ALREADY_SUCCEEDED",
										"type": "String"
									},
									"ErrorMessage": {
										"value": "NORMAL deterministic window already completed by another batch.",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						},
