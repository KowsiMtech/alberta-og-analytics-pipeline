{
	"name": "PL_MD_Entity_Window_Run",
	"properties": {
		"activities": [
			{
				"name": "Resolve_Window",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC control.usp_ResolveWindow @EntityName=''',pipeline().parameters.EntityName,''', @BatchId=''',pipeline().parameters.BatchId,''', @PipelineRunId=''',pipeline().RunId,''', @RunMode=''',pipeline().parameters.RunMode,''', @RecoveryMode=''',pipeline().parameters.RecoveryMode,''', @RequestedWindowStart=',if(empty(pipeline().parameters.WindowStart),'NULL',concat('''',pipeline().parameters.WindowStart,'''')),', @RequestedWindowEnd=',if(empty(pipeline().parameters.WindowEnd),'NULL',concat('''',pipeline().parameters.WindowEnd,'''')))",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set_WindowKey",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Resolve_Window",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_WindowKey",
					"value": {
						"value": "@activity('Resolve_Window').output.firstRow.WindowKey",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_StartWatermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_WindowKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_StartWatermark",
					"value": {
						"value": "@string(activity('Resolve_Window').output.firstRow.StartWatermark)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_EndWatermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_StartWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
