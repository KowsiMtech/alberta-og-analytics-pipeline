							],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "control.usp_ReleaseEntityLease",
								"storedProcedureParameters": {
									"EntityName": {
										"value": {
											"value": "@pipeline().parameters.EntityName",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Run_Process_Window",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"waitOnCompletion": true,
								"parameters": {
									"EntityName": {
										"value": "@pipeline().parameters.EntityName",
										"type": "Expression"
									},
									"BatchId": {
										"value": "@pipeline().parameters.BatchId",
										"type": "Expression"
									},
									"ParentRunId": {
										"value": "@pipeline().parameters.ParentRunId",
										"type": "Expression"
									},
									"RunMode": {
										"value": "@pipeline().parameters.RunMode",
										"type": "Expression"
									},
									"RecoveryMode": {
										"value": "@pipeline().parameters.RecoveryMode",
										"type": "Expression"
									},
									"ResumeFromStage": {
										"value": "@pipeline().parameters.ResumeFromStage",
										"type": "Expression"
									},
									"WindowKey": {
										"value": "@variables('v_WindowKey')",
										"type": "Expression"
									},
									"StartWatermark": {
										"value": "@variables('v_StartWatermark')",
										"type": "Expression"
									},
									"EndWatermark": {
										"value": "@variables('v_EndWatermark')",
										"type": "Expression"
									},
									"ExtractionStart": {
										"value": "@variables('v_ExtractionStart')",
										"type": "Expression"
									}
								}
							}
						}
