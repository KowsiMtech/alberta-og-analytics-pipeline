				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_EndWatermark",
					"value": {
						"value": "@string(activity('Resolve_Window').output.firstRow.EndWatermark)",
						"type": "Expression"
