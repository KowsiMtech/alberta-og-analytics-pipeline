{
	"name": "PL_MD_Common_Alert_Handler",
	"properties": {
		"description": "Central alert delivery plus alert audit history.",
		"activities": [
			{
				"name": "Lookup_Alert_Endpoint",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT EndpointUrl FROM control.AlertConfig WHERE AlertName=''LOGIC_APP_OPERATIONS'' AND IsActive=1')",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_MD_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Log_Alert_Pending",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Lookup_Alert_Endpoint",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_RecordAlert",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"AlertType": {
							"value": {
								"value": "@pipeline().parameters.AlertType",
								"type": "Expression"
							},
							"type": "String"
						},
						"Severity": {
							"value": {
								"value": "@pipeline().parameters.Severity",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": {
								"value": "@pipeline().parameters.ActivityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"Message": {
							"value": {
								"value": "@pipeline().parameters.Message",
								"type": "Expression"
							},
							"type": "String"
						},
						"DeliveryStatus": {
							"value": "PENDING",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Invoke_Logic_App",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Log_Alert_Pending",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@activity('Lookup_Alert_Endpoint').output.firstRow.EndpointUrl",
						"type": "Expression"
					},
					"body": {
						"value": "@json(concat('{\"AlertType\":\"',pipeline().parameters.AlertType,'\",\"Severity\":\"',pipeline().parameters.Severity,'\",\"EntityName\":\"',pipeline().parameters.EntityName,'\",\"PipelineRunId\":\"',pipeline().parameters.ParentRunId,'\",\"BatchId\":\"',pipeline().parameters.BatchId,'\",\"WindowKey\":\"',pipeline().parameters.WindowKey,'\",\"ActivityName\":\"',pipeline().parameters.ActivityName,'\",\"Message\":\"',replace(pipeline().parameters.Message,'\"','\\\"'),'\"}'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Log_Alert_Delivered",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Invoke_Logic_App",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "control.usp_RecordAlert",
					"storedProcedureParameters": {
						"EntityName": {
							"value": {
								"value": "@pipeline().parameters.EntityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().parameters.ParentRunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"BatchId": {
							"value": {
								"value": "@pipeline().parameters.BatchId",
								"type": "Expression"
							},
							"type": "String"
						},
						"WindowKey": {
							"value": {
								"value": "@pipeline().parameters.WindowKey",
								"type": "Expression"
							},
							"type": "String"
						},
						"AlertType": {
							"value": {
								"value": "@pipeline().parameters.AlertType",
								"type": "Expression"
							},
							"type": "String"
						},
						"Severity": {
							"value": {
								"value": "@pipeline().parameters.Severity",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": {
								"value": "@pipeline().parameters.ActivityName",
								"type": "Expression"
							},
							"type": "String"
						},
						"Message": {
							"value": {
								"value": "@pipeline().parameters.Message",
								"type": "Expression"
							},
							"type": "String"
						},
						"DeliveryStatus": {
							"value": "DELIVERED",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"EntityName": {
				"type": "String"
			},
			"BatchId": {
				"type": "String"
			},
			"ParentRunId": {
				"type": "String"
			},
			"WindowKey": {
				"type": "String"
			},
			"AlertType": {
				"type": "String"
			},
			"Severity": {
				"type": "String"
			},
			"ActivityName": {
				"type": "String"
			},
			"Message": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Metadata_Driven"
		},
		"annotations": [
			"ENTITY_DRIVEN",
			"ENTERPRISE_HARDENED",
			"ST37_SEEDED"
		]
	}
}